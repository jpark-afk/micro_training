# -std=c++98  
IF (${RTIME_TARGET_NAME} MATCHES "gcc3")
    SET(CC_COMMON   "-std=c99  -Wall -fstrict-aliasing -Wmissing-declarations")
    SET(CXX_COMMON   "-std=c++98  -Wall")
    SET(RTIME_FLATDATA_DISABLE true)
    ADD_DEFINITIONS(-DRTIME_FLATDATA_DISABLED=1)
ELSE()    
    SET(CC_COMMON   "-std=c99  -Wextra -Wall -Winit-self  -fstrict-aliasing -Wmissing-declarations")
    SET(CXX_COMMON   "-Wextra -Wall -Winit-self ")
    IF (${RTIME_TARGET_NAME} MATCHES "_gprof")
        SET(CC_COMMON   "${CC_COMMON} -pg ")
        SET(CXX_COMMON   "${CXX_COMMON} -pg ")
    ENDIF()
    IF (${RTIME_TARGET_NAME} MATCHES "_gcov")
        SET(CC_COMMON   "${CC_COMMON} -ftest-coverage -fprofile-arcs ")
        SET(CXX_COMMON   "${CXX_COMMON} -ftest-coverage -fprofile-arcs ")
    ENDIF()
ENDIF()

SET(CC_DEBUG    "${CC_COMMON}  -O0 -g")
SET(CC_RELEASE  "${CC_COMMON} -O ")
SET(CXX_DEBUG    "${CXX_COMMON} -O0 -g")
SET(CXX_RELEASE  "${CXX_COMMON} -O ")

IF (${RTIME_TARGET_NAME} MATCHES "x64")
    SET(CC_ARCH "-m64")
ELSEIF (${RTIME_TARGET_NAME} MATCHES "i86")
    SET(CC_ARCH "-m32")
ENDIF()

SET(_RTIME_CC stdc)

SET(CMAKE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS} ${CC_DEBUG} ${CC_ARCH}" CACHE INTERNAL "CMAKE_C_FLAGS_DEBUG" FORCE)
SET(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS} ${CXX_DEBUG} ${CC_ARCH}" CACHE INTERNAL "CMAKE_CXX_FLAGS_DEBUG" FORCE)
SET(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS} ${CC_RELEASE} ${CC_ARCH} -DNDEBUG" CACHE INTERNAL "CMAKE_C_FLAGS_RELEASE" FORCE)
SET(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS} ${CXX_RELEASE} ${CC_ARCH} -DNDEBUG" CACHE INTERNAL "CMAKE_CXX_FLAGS_RELEASE" FORCE)

IF (${TARGET_HELP})
    MESSAGE("COMPILER NOTES\n")
    MESSAGE(" The following GCC specific flags are used based on RTIME_TARGET_NAME\n")        
    MESSAGE(" - If x64 is part of the name 64 bit is used")
    MESSAGE(" - If i86 is part of the name 32 bit is used")
    MESSAGE(" - If i86 or x64 is not found, the default is used\n")
    MESSAGE(" The following flags are added:")
    MESSAGE(" - For C Debug libraries:  ${CC_DEBUG}")
    MESSAGE(" - For C++ Debug libraries:  ${CXX_DEBUG}")
    MESSAGE(" - For C Release libraries:  ${CC_RELEASE}")
    MESSAGE(" - For C++ Release libraries:  ${CXX_RELEASE}\n\n")
    RETURN()
ENDIF()
