INCLUDE(CMakeForceCompiler)
SET(_RTIME_OSAPI_PLATFORM autosar)

SET(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)

SET(RTIME_NO_SHARED_LIB TRUE)

SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

IF (DEFINED ENV{OSEK_PATH})
    STRING(REPLACE "\\" "/" VSTAR_PATH $ENV{OSEK_PATH})
ELSE()
    MESSAGE("Please set the OSEK_PATH environment variable. Example:")
    MESSAGE("set OSEK_PATH=c:\\AUTOSAR")
    MESSAGE(FATAL_ERROR "")
ENDIF()

INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/COM/TcpIp/ssc/inc")
INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/COM/TcpIp/ssc/ext/inc")
