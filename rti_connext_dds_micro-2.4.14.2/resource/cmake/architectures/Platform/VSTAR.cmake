INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/Os/Os/core/ssc/inc/internal")
INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/Os/Os/ssc/inc")
INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/RTE/Rte/ssc/inc")
INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/DIAG/Dem/ssc/inc")
INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/LIB/VSTAR_Bits/ssc/inc")

#ADD_DEFINITIONS(-DATOMICS_USE_GENERIC_IMPL=1)

IF (RTIME_TARGET_NAME MATCHES "Tasking")
    INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/BSWs/Os/Os/ssc/compiler/Tasking/inc")
ENDIF()

IF (RTIME_TARGET_NAME MATCHES "^tc29xt")
    INCLUDE_DIRECTORIES("${VSTAR_PATH}/VSTAR/TTs/TriCore161/compiler_common/platform/TriBoard_TC29x/inc")
    SET(RTI_ENDIAN_LITTLE 1)
ELSE()
    MESSAGE(FATAL_ERROR "No architecture recognized, please select one from: tc29xt.")
ENDIF()

SET(RTIME_INCLUDE_AUTOSAR true)

