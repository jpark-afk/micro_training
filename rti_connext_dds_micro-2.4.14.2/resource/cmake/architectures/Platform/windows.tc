INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)

SET(_RTIME_OSAPI_PLATFORM windows)

SET(PLATFORM_LIBS ws2_32 netapi32 advapi32 user32 winmm)

IF (${TARGET_HELP})
ELSE()
    ADD_DEFINITIONS(-DWIN32_LEAN_AND_MEAN)
    ADD_DEFINITIONS(-D_WIN32_WINNT=0x0600)
ENDIF()

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")
    MESSAGE(" The following macro definitions are added for Windows:")
    MESSAGE(" - WIN32_LEAN_AND_MEAN")
    MESSAGE(" - _WIN32_WINNT=0x0600")
    MESSAGE(" The following libraries are included for Windows:")
    MESSAGE(" - ${PLATFORM_LIBS}")
    MESSAGE("\n")
ENDIF()
