INCLUDE(CMakeForceCompiler)

SET(CMAKE_SYSTEM_NAME Linux)
SET(CMAKE_SYSTEM_PROCESSOR arm)

SET(COMPILER_PATH /local/applications/raspberrypi/tools/arm-bcm2708/gcc-linaro-arm-linux-gnueabihf-raspbian/bin)
SET(CMAKE_CXX_COMPILER ${COMPILER_PATH}/arm-linux-gnueabihf-g++)
SET(CMAKE_C_COMPILER   ${COMPILER_PATH}/arm-linux-gnueabihf-gcc) 

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
