SET(CMAKE_SYSTEM_NAME Linux)

SET(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
SET(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
SET(RTIME_OBJDUMP aarch64-linux-gnu-objdump)
SET(RTIME_OBJDUMPCHKSUM aarch64-linux-gnu-objdump)
SET(RTIME_OBJDUMPCHKSUM_OPT --section=.text --section=.data --section=.rodata --disassemble-all)
SET(RTIME_OBJ_SUFFIX o)
SET(RTIME_AR_EXRACT -x)
SET(RTIME_AR aarch64-linux-gnu-ar)

SET(_RTIME_CC stdc)
SET(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS} -DNDEBUG" CACHE INTERNAL "CMAKE_C_FLAGS_RELEASE" FORCE)
SET(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS} -DNDEBUG" CACHE INTERNAL "CMAKE_CXX_FLAGS_RELEASE" FORCE)

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)

IF (RTIME_TARGET OR RTI_BUILD_UNITTESTS)
ENDIF()