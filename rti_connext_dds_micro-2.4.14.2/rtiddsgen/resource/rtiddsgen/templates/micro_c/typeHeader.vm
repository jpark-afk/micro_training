##---------------------------------------------------------------------
#autogeneratedHeader

${envMap.POUND_CHAR}ifndef ${envMap.idlFileName.replace(".","_").replace("-","_")}_${envMap.executionID}_h
${envMap.POUND_CHAR}define ${envMap.idlFileName.replace(".","_").replace("-","_")}_${envMap.executionID}_h

#if ($envMap.stringIsObject)
#*--*##setExtraVariables()
#*--*##addStringIncludes()
#end

## FACE needs C++ types, but with C type support.
#if( $envMap.language.equals("C") || $envMap.generateFaceCode )
${envMap.POUND_CHAR}ifndef rti_me_c_h
  ${envMap.POUND_CHAR}include "rti_me_c.h"
#else
${envMap.POUND_CHAR}ifndef rti_me_cpp_hxx
  ${envMap.POUND_CHAR}include "rti_me_cpp.hxx"
#end
${envMap.POUND_CHAR}endif

#defineDllExportStart

#externCIfRequiredStart

#foreach($node in $constructMapList)
#*--*##if($node.constructKind.equals("directive"))
#*----*##if($node.directiveKind.equals("copy-c")
             ||$node.directiveKind.equals("copy")
             ||$node.directiveKind.equals("copy-declaration")
             ||$node.directiveKind.equals("copy-c-declaration"))
$node.value
#*----*##end
#*--*##elseif($node.constructKind.equals("module"))
#*----*##if(${envMap.namespace})
namespace $node.name {
#*----*##end
#*--*##elseif($node.constructKind.equals("moduleClose"))
#*----*##if(${envMap.namespace}) 
} /* namespace $node.name  */
#*----*##end
#*--*##elseif($node.constructKind.equals("include"))
${envMap.POUND_CHAR}include "${node.file}.h"
#*--*##elseif($node.constructKind.equals("const"))
#createTypeFieldMember($node $node)
#defineConstant( $node)
#*--*##elseif($node.constructKind.equals("structFwd") 
                 || $node.constructKind.equals("valueTypeFwd")
                 || $node.constructKind.equals("unionFwd"))
#*----*##if($envMap.language.equals("C")
               || $node.constructKind.equals("unionFwd"))
struct ${node.nativeFQNameInModule};
#*----*##else
class ${node.nativeFQNameInModule};
#*----*##end
#*--*##else
#*----*##if($node.constructKind.equals("enum"))
#declareEnum ($node)
#*----*##elseif($node.constructKind.equals("alias"))
#createTypeField($node.memberFieldMapList $node)
#defineAlias($node)
#*----*##elseif($node.isAggregationType)                 
#declareComplexType($node)
#*----*##end

#*------*##if($node.topLevel)
NDDSUSERDllExport extern const char *${node.nativeFQNameInModule}TYPENAME;
#*------*##end

#declareTypeSequenceStruct($node)

#declareTypeSequenceFunctions($node)
#declareTypeFunctions($node)

#*--*##end

#end

#defineDllExportEnd

#externCIfRequiredEnd

${envMap.POUND_CHAR}endif /* ${envMap.idlFileName.replace(".","_").replace("-","_")} */

