#macro(defineFnTypeSupportRegisterUnregister $member)
DDS_ReturnCode_t
${member.nativeFQNameInModule}TypeSupport_register_type(
                    DDS_DomainParticipant* participant,
                    const char* type_name)
{
    DDS_ReturnCode_t retcode = DDS_RETCODE_ERROR;

    if (participant == NULL) 
    {
        goto done;
    }
    
    if (type_name == NULL) 
    {
        type_name = ${member.nativeFQNameInModule}TypePlugin_get_default_type_name();
        if (type_name == NULL)
        {
            goto done;
        }
    }

    retcode = DDS_DomainParticipant_register_type(
                participant,
                type_name,
                ${member.nativeFQNameInModule}TypePlugin_get());
                
    if (retcode != DDS_RETCODE_OK)
    {
        goto done;
    }
    
    retcode = DDS_RETCODE_OK;

done:

    return retcode;
}

${envMap.POUND_CHAR}ifndef RTI_CERT
DDS_ReturnCode_t
${member.nativeFQNameInModule}TypeSupport_unregister_type(
                    DDS_DomainParticipant* participant,
                    const char* type_name)
{
    DDS_ReturnCode_t retcode = DDS_RETCODE_ERROR;

    if (participant == NULL) 
    {
        goto done;
    }
    
    if (type_name == NULL) 
    {
        type_name = ${member.nativeFQNameInModule}TypePlugin_get_default_type_name();
        if (type_name == NULL)
        {
            goto done;
        }
    }

    if (${member.nativeFQNameInModule}TypePlugin_get() !=
            DDS_DomainParticipant_unregister_type(participant,type_name))
    {
        goto done;
    }
    
    retcode = DDS_RETCODE_OK;

done:

    return retcode;
}
