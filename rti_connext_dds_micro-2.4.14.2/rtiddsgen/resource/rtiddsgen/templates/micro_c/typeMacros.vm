##------------------------------------------------------------------------------
## Macro to intialize a member with an alias
##------------------------------------------------------------------------------
#macro(initUser $member )
    if (!${member.nativeTypeFQName}_initialize(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end))
    {
        return RTI_FALSE;
    }
#end

##------------------------------------------------------------------------------
## Macro to intialize arrays or sequences
##------------------------------------------------------------------------------
#macro(initArrayofSeq $member)
    {
        RTI_INT32 i;
        for (i = 0; i < #addDimensionMultiplication($member) ; i++)
        {
#initSeq($member)
        }
    }
#end

##------------------------------------------------------------------------------
## Macro to intialize sequences
##------------------------------------------------------------------------------
#macro(initSeq $member)
#if($member.typeKind.equals("user"))
    if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#if($member.dimensionList)[i]#end#else${member.samplePoint}#if($member.dimensionList)[i]#end#end))
    {
        return RTI_FALSE;
    }
    if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#if($member.dimensionList)[i]#end#else${member.samplePoint}#if($member.dimensionList)[i]#end#end, ($member.seqSize)))
    {
        return RTI_FALSE;
    }
#elseif($member.strSize)
#*--*##initializeStringSeq($member)
#else
#*--*##if($member.dimensionList)
        if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}[i]#else&(*${member.samplePoint})[i] #end))
        {
            return RTI_FALSE;
        }
        if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}[i]#else&(*${member.samplePoint})[i] #end,($member.seqSize)))
        {
            return RTI_FALSE;
        }
#*--*##else
    if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint} #end))
    {
        return RTI_FALSE;
    }
    if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint} #end,($member.seqSize)))
    {
        return RTI_FALSE;
    }
#*--*##end
#end

## For FACE, we need to set an extra bit in the _flags
## field so we know it has been initialized.
#*--*##if($envMap.generateFaceCode)
    RTI_RedaSequence_set_initialized((DDS_CharSeq*) #if(!$member.name.equals(""))(${member.sampleRef}${member.name}#if($member.dimensionList)[i]#end)#else${member.samplePoint}#if($member.dimensionList)[i]#end#end);
#*--*##end

#end

