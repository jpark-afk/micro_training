##******************************************************************************
## Macro to copyKeyCode
##******************************************************************************

#macro(copyKeyCode $member)
#*--*##if($member.dimensionList &&  $member.seqSize)
#*----*##copyKeyCodeArrayofSeq($member)
#*--*##elseif($member.seqSize)
#*----*##copyKeyCodeSeq($member)
#*--*##elseif($member.dimensionList)
#*----*##copyKeyCodeArray($member) 
#*--*##elseif($member.typeKind=="user")
#*----*##copyKeyCodeUser($member)
#*----*##elseif($member.strSize)
if (!${member.elementCopyMethod}(
        dst->${member.name}, src->${member.name}, (${member.strSize}) + 1)) {
        return RTI_FALSE;
    }
#*----*##else
if (!${member.elementCopyMethod}(
        &dst->${member.name}, &src->${member.name}))
{
    return RTI_FALSE;
}
#*--*##end
#end

##-----------------------------------------------------------------------------
## Macro to copyKey Array of Sequence
##-----------------------------------------------------------------------------
#macro(copyKeyCodeArrayofSeq $member)
{
        RTI_UINT32 i;

        for (i = 0; i <  #addDimensionMultiplication($member); i++)
        {
        #copyKeyCodeSeq ($member)
        }
}
#end

##-----------------------------------------------------------------------------
## Macro to copyKey typedef (alias)
##-----------------------------------------------------------------------------
#macro(copyKeyCodeUser $member)
    if (!${member.nativeTypeFQName}_copy(
        &dst->${member.name}, &src->${member.name}))
    {
        return RTI_FALSE;
    }
  
#end

##-----------------------------------------------------------------------------
## Macro to copyKey Sequence
##-----------------------------------------------------------------------------
#macro(copyKeyCodeSeq $member)
    if (!${member.sequenceCopyMethod}(&dst->${member.name}#if($member.dimensionList)[i]#end,
                                      &src->${member.name}#if($member.dimensionList)[i]#end #if($member.strSize && !$member.typeKind.equals("user")),(${member.strSize}))#end)
    {

        return RTI_FALSE;
    }

#end

##-----------------------------------------------------------------------------
## Macro to copyKey Array
##-----------------------------------------------------------------------------

#macro(copyKeyCodeArray $member)
#*--*##if ($member.typeKind=="user")
    {
        int i = 0;
        ${member.nativeTypeFQName}* elemOut = ( ${member.nativeTypeFQName}*) &dst->${member.name}[0];
        const  ${member.nativeTypeFQName}* elemIn = (const  ${member.nativeTypeFQName}*) &src->${member.name}[0];

        for (i = 0; i < #addDimensionMultiplication($member);
             ++i, ++elemOut, ++elemIn)
        {
            if (!${member.nativeTypeFQName}_copy(elemOut,(const  ${member.nativeTypeFQName}*)elemIn))
            {
                return RTI_FALSE;
            }
        }
     }   
#*--*##elseif ($member.strSize)
#*----*##copyStringArray($member)
#*--*##else
#*--*# CDR_Primitive_copy_array(dst->${member.name}, src->${member.name}, (#addDimensionMultiplication($member)*${member.elementSize}));
#*--*##end
#end


