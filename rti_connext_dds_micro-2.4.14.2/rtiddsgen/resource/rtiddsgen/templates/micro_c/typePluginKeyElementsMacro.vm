##******************************************************************************
## Macro to serialize_key members
##******************************************************************************
#macro(serialize_key $struct)
#*--*##if($struct.hasKey || $struct.constructKind=="alias")
#*----*##foreach($member in $struct.memberFieldMapList)
#*------*##if($member.isKey || $struct.constructKind=="alias")
#*----------*##serializeMember($member "_key")
#*------*##end##memberiskey
#*----*##end##foreach
#*--*##else
#*----*##if(!${struct.hasKeyBaseType})    
        if (!${struct.baseTypeFQName}_cdr_serialize(
                    stream,sample,param))
        {
                return RTI_FALSE;
        }
#*----*##end##hasKeyBaseType            
#*--*##end##haskey
#end



##******************************************************************************
## Macro to deserialize_key members
##******************************************************************************

#macro(deserialize_key $struct)
#*--*##if($struct.hasKey || $struct.constructKind=="alias")
#*----*##foreach($member in $struct.memberFieldMapList)
#*-----*##if($member.isKey || $struct.constructKind=="alias")
#*--------*##deserializeMember($member "_key")
#*------*##end##memberiskey
#*----*##end##foreach
#*--*##else
#*----*##if(!${struct.hasKeyBaseType})   
        if (!${struct.baseTypeFQName}_cdr_deserialize(
                endpoint_data, sample, stream, 
                RTI_FALSE, RTI_TRUE, 
                endpoint_plugin_qos))
        {
                 return RTI_FALSE;
        }
#*----*##end
#*--*##end
#end


