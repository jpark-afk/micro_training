#macro(defineFnGetSerializedSampleMaxSize $member)
RTI_UINT32
${member.nativeFQNameInModule}_get_serialized_sample_max_size(
    struct NDDS_Type_Plugin *plugin,
    RTI_UINT32 current_alignment,
    void *param)
{
#if($member.constructKind.equals("union"))
    RTI_UINT32 temp, union_max_size_serialized = 0;
#end
    RTI_UINT32 initial_alignment = current_alignment;

#if($member.constructKind.equals("enum"))
    UNUSED_ARG(plugin);
    UNUSED_ARG(param);
    current_alignment += CDR_get_max_size_serialized_enum(current_alignment);
#else
#*--*##if($member.baseTypeFQName)  
    current_alignment += ${member.baseTypeFQName}_get_serialized_sample_max_size(
        plugin, current_alignment, param);
#*--*##else
    UNUSED_ARG(plugin);
    UNUSED_ARG(param);
#*--*##end
#*--*##if($member.constructKind.equals("union"))
    #createCurrentAligmentMaxSizeUnion($member)## Call to a macro here !!!
#*--*##else
    #CreateCurrentAligmentMaxSize($member.memberFieldMapList)## Call to a macro here !!!
#*--*##end
#end
    
    return #if($member.constructKind.equals("union"))union_max_size_serialized +#end current_alignment - initial_alignment;
}
#end

