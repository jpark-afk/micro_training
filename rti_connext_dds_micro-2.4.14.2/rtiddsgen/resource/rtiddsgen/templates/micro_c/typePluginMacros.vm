#macro(serialize $memberFieldMapList $key)
#*--*##foreach($member in $memberFieldMapList)
#if($node.constructKind.equals("union"))
#initCases($member)
#end
#if($member.directive)
#printCopyDirectiveNoDeclaration($member)
#else
#serializeMember($member $key)
#end
#if($node.constructKind.equals("union"))
        } #if($member.label.get(0)!="(default)")break #end;
#end
#*--*##end
#end

#macro(deserialize $memberFieldMapList $key)
#*--*##foreach($member in $memberFieldMapList)
#if($node.constructKind.equals("union"))
#initCases($member)
#end
#if($member.directive)
#printCopyDirectiveNoDeclaration($member)
#else
#deserializeMember($member $key)
#end
#if($node.constructKind.equals("union"))
        } #if($member.label.get(0)!="(default)")break #end;
#end
#*--*##end
#end

##------------------------------------------------------------------------------
##Macro to Serialize/Deserialize a member of a struct
##------------------------------------------------------------------------------

#macro(serializeMember $member $key)
#*--*##if($member.dimensionList && $member.seqSize) 
#*----*##serializeArrayofSeq($member $key)
#*--*##elseif($member.dimensionList)
#*----*##serializeArray($member $key)
#*--*##elseif($member.seqSize)
#*----*##serializeSeq($member $key)
#*--*##elseif($member.typeKind.equals("user"))
#*----*##serializeUser($member $key)
#*--*##else
#*----*##serializePrimitives($member)
#*--*##end
#end

#macro(deserializeMember $member $key)
#*--*##if($member.dimensionList && $member.seqSize) 
#*----*##deserializeArrayofSeq($member $key)
#*--*##elseif($member.dimensionList)
#*----*##deserializeArray($member $key)
#*--*##elseif($member.seqSize)
#*----*##deserializeSeq($member $key)
#*--*##elseif($member.typeKind.equals("user"))
#*----*##deserializeUser($member $key)
#*--*##else
#*----*##deserializePrimitives($member)
#*--*##end
#end

##------------------------------------------------------------------------------
##Macro to Serialize/Deserialize an array of sequences
##------------------------------------------------------------------------------
#macro(serializeArrayofSeq $member $key)
   { 
        RTI_UINT32 i;
        for (i = 0; i<  #addDimensionMultiplication($member); ++i)
        {
#serializeSeq ($member $key)
        }
   }
#end

#macro(deserializeArrayofSeq $member $key)
   { 
        RTI_UINT32 i;
        for (i = 0; i<  #addDimensionMultiplication($member); i++)
        {
#deserializeSeq ($member $key)
        }
   }
#end

##------------------------------------------------------------------------------
##Macro to serialize sequences
##------------------------------------------------------------------------------
#macro(serializeSeq $member $key )
#*--*##if($member.typeKind.equals("user"))
        if (!CDR_Stream_serialize_non_primitive_sequence(
                stream,
                (const struct REDA_Sequence* ) #if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end#if($member.dimensionList)[i]#end,
                (CDR_Stream_SerializeFunction) ${member.nativeTypeFQName}_cdr_serialize${key},
                param))
        {
            return RTI_FALSE;
        }
#*--*##elseif($member.strSize)
#*----*##serializeStringSeq($member)
#*--*##else
        if (!CDR_Stream_serialize_primitive_sequence(
                stream,
                (const struct REDA_Sequence*) #if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end#if($member.dimensionList)[i]#end,
                ${member.typeEnum}))
        {
            return RTI_FALSE;
        }
    #end
#end

