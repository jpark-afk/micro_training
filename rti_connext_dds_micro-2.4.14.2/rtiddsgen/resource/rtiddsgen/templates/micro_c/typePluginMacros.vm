#macro(defineFnTypePluginCreateSample $member)
RTI_BOOL
${member.nativeFQNameInModule}Plugin_create_sample(
    struct NDDS_Type_Plugin *plugin, void **sample, void *param)
{
    UNUSED_ARG(plugin);
    UNUSED_ARG(param);

    if (sample == NULL)
    {
        return RTI_FALSE;
    }

    *sample = (void *) ${member.nativeFQNameInModule}_create();

    return (*sample != NULL);
}
#end

#macro(defineFnTypePluginDeleteSample $member)
RTI_BOOL
${member.nativeFQNameInModule}Plugin_delete_sample(
    struct NDDS_Type_Plugin *plugin, void *sample, void *param)
{
    UNUSED_ARG(plugin);
    UNUSED_ARG(param);
    /* ${member.nativeFQNameInModule}_delete() is a void function
     * which expects (sample != NULL). Since 
     * ${member.nativeFQNameInModule}Plugin_delete_sample
     * is an internal function, sample is assumed to be a valid pointer 
     */ 
    ${member.nativeFQNameInModule}_delete((${member.nativeFQNameInModule} *) sample);
    return RTI_TRUE;
}
#end

