#macro(defineFnCDRSerialize $member)
RTI_BOOL 
${member.nativeFQNameInModule}_cdr_serialize(
    struct CDR_Stream_t *stream, const void *void_sample, void *param)
{
    ${member.nativeFQNameInModule} *sample = (${member.nativeFQNameInModule} *)void_sample;
  
    if ((stream == NULL) || (void_sample == NULL))
    {
        return RTI_FALSE;
    }

#if($member.constructKind.equals("enum"))
    UNUSED_ARG(param);
${envMap.POUND_CHAR}if CDR_VARIABLE_ENUM_ENABLED
    if (!CDR_Stream_serialize_enum_value(stream, *sample))
    {
       return RTI_FALSE;
    }
${envMap.POUND_CHAR}else
    if (!CDR_Stream_serialize_enum(stream, sample))
    {
       return RTI_FALSE;
    }
${envMap.POUND_CHAR}endif
    
#else #* if($node.constructKind.equals("enum") *#
#*--*##if($member.baseTypeFQName)  
    if (!${member.baseTypeFQName}_cdr_serialize(stream,(const ${member.baseTypeFQName}*)sample,param))
    {
        return RTI_FALSE;
    }
#*--*##else
    UNUSED_ARG(param);
#*--*##end

##-------------------------------------
#### Call to a macro here to serialize the elements of the struct
## 
##-------------------------------------
#*--*##if($member.constructKind.equals("union"))
    #createTypeFieldMember($member.unionDiscriminatorMap $member)
    #serializeMember($member.unionDiscriminatorMap "")
    switch(sample->_d)
    {
#*--*##end
    #serialize($member.memberFieldMapList "")
#end
#if($member.constructKind.equals("union"))
    }
#end
  
    return RTI_TRUE;
}
#end

