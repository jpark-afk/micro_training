    {
        return RTI_FALSE;
    }  
#*--*##end
#end


##******************************************************************************
## Macro to AligmentMaxSize
##******************************************************************************

#macro(CreateCurrentAligmentMaxSize $memberFieldMapList)
#*--*##foreach($member in $memberFieldMapList)
#if($member.directive)
#printCopyDirectiveNoDeclaration($member)
#else
#CreateCurrentAligmentMaxSizeMember($member)
#end
#*--*##end## We need an intro before to separate each member
#end


#macro (CreateCurrentAligmentMaxSizeMember $member)
#*----*##if($member.dimensionList && $member.seqSize)
#*------*##getMaxSizeArrayofSeq($member "sample")
#*----*##else
    current_alignment += #aligmentMaxSizeMember($member);
         
#end
#end

#macro (aligmentMaxSizeMember $member)
#*----*##if($member.seqSize)#*
--------*##getMaxSizeSeq($member "sample" "current_alignment")#*
------*##elseif($member.dimensionList)#*
--------*##getMaxSizeSerialized_PrimitiveArray($member "sample")#*
------*##elseif($member.typeKind.equals("user"))#*
--------*##getUserMaxSizeSerialized($member)#*
------*##else#*
--------*#${member.elementSizeMethod}(
#*------*#        current_alignment#if($member.strSize), ($member.strSize)+1#end)#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of an array of sequences
##------------------------------------------------------------------------------

#macro(getMaxSizeArrayofSeq $member $key)
{
        RTI_UINT32 i, maxSize = current_alignment;

        for (i = 0; i <#addDimensionMultiplication($member); i++)
        {
#*--*##if($member.typeKind.equals("user"))
            maxSize += CDR_get_max_size_serialized_non_primitive_sequence(
                maxSize, ($member.seqSize),
                ${member.nativeTypeFQName}_get_serialized_${key}_max_size,
                param);
#*--*##elseif($member.strSize)
            maxSize += CDR_get_max_size_serialized_string_sequence(
                maxSize, ($member.seqSize), ($member.strSize), ${member.typeEnum});
                
#*--*##else
            maxSize += CDR_get_max_size_serialized_primitive_sequence(
                maxSize, ($member.seqSize), ${member.typeEnum});
        
#*--*##end
        }

        current_alignment +=  (maxSize - current_alignment) ;
    }
#end

##------------------------------------------------------------------------------
## Macro to getMaxSize of a sequence
##------------------------------------------------------------------------------

#macro(getMaxSizeSeq $member $key $var)
#*--*##if($member.typeKind.equals("user"))
CDR_get_max_size_serialized_non_primitive_sequence(
        $var, ($member.seqSize),
         ${member.nativeTypeFQName}_get_serialized_${key}_max_size,
         param)#*
----*##elseif($member.strSize)
CDR_get_max_size_serialized_string_sequence(
        $var,(${member.seqSize}),($member.strSize),${member.typeEnum}) #*    
----*##else
CDR_get_max_size_serialized_primitive_sequence(
        $var, (${member.seqSize}), ${member.typeEnum})#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of a alias(typedef)
##------------------------------------------------------------------------------

#macro(getUserMaxSizeSerialized $member)
${member.nativeTypeFQName}_get_serialized_sample_max_size(
        plugin, current_alignment, param)#*
*##end


##------------------------------------------------------------------------------
## Macro to getMaxSize of a array
##------------------------------------------------------------------------------
#macro(getMaxSizeSerialized_PrimitiveArray $member $key)
#*--*##if($member.typeKind.equals("user"))
CDR_get_max_size_serialized_non_primitive_array(
        current_alignment, #addDimensionMultiplication($member),
        (CDR_Stream_GetSerializedSizeFunction) ${member.nativeTypeFQName}_get_serialized_${key}_max_size,
        param)#*
----*##elseif($member.strSize)
CDR_get_max_size_serialized_string_array(
        current_alignment, #addDimensionMultiplication($member), ($member.strSize), ${member.typeEnum})#*
----*##else
CDR_get_max_size_serialized_primitive_array(
        current_alignment, #addDimensionMultiplication($member), ${member.typeEnum})#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of an  Union
##------------------------------------------------------------------------------
#macro (createCurrentAligmentMaxSizeUnion $node)
#CreateCurrentAligmentMaxSizeMember($node.unionDiscriminatorMap)
#foreach($member in $node.memberFieldMapList)
#*----*##if($member.dimensionList && $member.seqSize)
    {
        RTI_UINT32 i;
        unsigned int maxSize = current_alignment;

        for (i = 0; i < #addDimensionMultiplication($member); i++)
        {
            maxSize += #getMaxSizeSeq($member "sample" "maxSize");
        }

        temp = maxSize - current_alignment;
    }
#*----*##else
    temp = #aligmentMaxSizeMember($member);
#*----*##end
    if (union_max_size_serialized < temp)
    {
        union_max_size_serialized = temp;
    }
#end
#end

