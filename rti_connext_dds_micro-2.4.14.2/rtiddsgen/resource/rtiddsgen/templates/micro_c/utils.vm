#macro(multiplicationIfNeeded $index $member)
#set ( $lastone = $member.dimensionList.size() - 1 )
#if( $index <= $lastone)*#end
#end

#macro(addDimensionMultiplication $member)#if($member.dimensionList)#foreach($element in $member.dimensionList)#*
*#($element)#multiplicationIfNeeded($foreach.count $member)#end#end#end

#macro(commaIfNeeded $index $v)
#set ( $lastone = $v.size() - 1 )
#if( $index <= $lastone), #end
#end

#macro(getDimension $index $dimension)
#set ( $lastDim =$dimension.size() - 1 )
#foreach ($d in $dimension)
$d#if( $index <= $lastDim), #end
#end
#end

