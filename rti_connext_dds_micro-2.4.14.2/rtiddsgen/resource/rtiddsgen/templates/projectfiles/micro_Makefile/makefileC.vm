#if(!$global.noDefaultNddshome)
#[[#]]# Set RTIMEHOME to installation dir 
ifndef RTIMEHOME
    RTIMEHOME := "${global.rtimeHome}"
endif
#end

RTIMEARCH = ${global.architectureName}

COMPILER_FLAGS =#foreach($compilerFlag in ${compilerFlags}) -$compilerFlag#end

LINKER_FLAGS =#foreach($linkerFlag in ${linkerFlags}) -$linkerFlag#end

ifneq (#[[$]]#(findstring Darwin,#[[$]]#(RTIMEARCH)),)
        ARCH_LIBS= 
        CFLAGS = -m32 -std=c99 -g
        LFLAGS = -m32 -static-libgcc
        CC = ${compiler}
        LINKER = ${linker}
        DEFINES = -DRTI_UNIX -DRTI_DARWIN -DRTI_POSIX_THREADS
endif
ifneq (#[[$]]#(findstring Linux,#[[$]]#(RTIMEARCH)),)
        ARCH_LIBS=-ldl -lnsl -lm -lpthread -lrt
        CFLAGS = ${COMPILER_FLAGS}
        LFLAGS = ${LINKER_FLAGS}
        CC = ${compiler}
        LINKER = ${linker}
        DEFINES = -DRTI_UNIX -DRTI_LINUX -DRTI_POSIX_THREADS
endif
ifneq (#[[$]]#(findstring sparc,#[[$]]#(RTIMEARCH)),)
        ARCH_LIBS=-ldl -lnsl -lgenIO -lsocket -lgen -lposix4 -lpthread -lm -lc
        CFLAGS = -m32
        LFLAGS = -m32
        CC = ${compiler}
        LINKER = ${linker}
        DEFINES = -DRTI_UNIX -DRTI_SOLARIS -DRTI_POSIX_THREADS
endif

ifeq (#[[$]]#(DEBUG),Y)
LIBSUFFIX=d
CFLAGS += -g
endif

ifndef DEBUG
#if(${global.libSuffix}=="d" || ${global.libSuffix}=="zd")
    DEBUG=Y
#else
    DEBUG=N 
#end
endif
ifeq ($(DEBUG),Y)
    CFLAGS += -g -O0
    LFLAGS += -g
    LIBSUFFIX_DEBUG=d
else
    LIBSUFFIX_DEBUG= 
endif
 
ifndef SHAREDLIB
#if(${global.libSuffix}=="z" || ${global.libSuffix}=="zd")
    SHAREDLIB=N
#else
    SHAREDLIB=Y
#end
endif

ifeq ($(SHAREDLIB),Y)
    LIBSUFFIX = #[[$]]#(LIBSUFFIX_DEBUG)
else
    LIBSUFFIX = z#[[$]]#(LIBSUFFIX_DEBUG)
endif

INCLUDES = -I. -I#[[$]]#(RTIMEHOME)/include -I#[[$]]#(RTIMEHOME)/include/rti_me

LIBS = -L#[[$]]#(RTIMEHOME)/lib/#[[$]]#(RTIMEARCH) #foreach($coreLib in ${corelibs}) -l$coreLib$(LIBSUFFIX)#end #[[$]]#(ARCH_LIBS)
	   
COMMONSRCS    = ${global.idlFileName}${sourceFileExtension} ${global.idlFileName}Plugin${sourceFileExtension} ${global.idlFileName}Support${sourceFileExtension} ${global.idlFileName}Application${sourceFileExtension}  
IDL_HEADERS   = ${global.idlFileName}.h ${global.idlFileName}Plugin.h ${global.idlFileName}Support.h
IDL_SRCS      = ${global.idlFileName}${sourceFileExtension} ${global.idlFileName}Plugin${sourceFileExtension} ${global.idlFileName}Support${sourceFileExtension}
EXEC          = ${global.idlFileName}_publisher ${global.idlFileName}_subscriber 
DIRECTORIES   = objs.dir objs/#[[$]]#{RTIMEARCH}.dir
COMMONOBJS    = #[[$]]#(COMMONSRCS:%${sourceFileExtension}=objs/#[[$]]#{RTIMEARCH}/%.o)

ifneq (#[[$]]#(findstring pentiumVx6.9gcc4.3.3,#[[$]]#(RTIMEARCH)),)
	DEFINES = -DRTI_VXWORKS -march=pentium -fno-builtin -DTOOL=gnu -DCPU=PENTIUM

	ifneq (#[[$]]#(findstring _rtp,#[[$]]#(RTIMEARCH)),)
                OUTSUFFIX = vxe
                DEFINES += -DRTI_RTP
		
		ifneq (#[[$]]#(findstring Linux,#[[$]]#(RTIMEARCH)),)
	        	validHost = Y
			CC = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ccpentium
                	LD = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ldpentium
                	INCLUDES += -I#[[$]]#(WIND_USR)/h \
			            -I#[[$]]#(WIND_USR)/h/wrn/coreip
			CFLAGS += -mrtp
                        LFLAGS += -mrtp
			LIBS += -L#[[$]]#(WIND_BASE)/target/lib/usr/lib/pentium/PENTIUM/common
		endif
		OUTCOMMAND = #[[$]]#(LD) -r -o #[[$]]#@ #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.vxe) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
	else
        	OUTSUFFIX = so
		ifneq (#[[$]]#(findstring Linux,#[[$]]#(RTIMEARCH)),)
	        	validHost = Y
                	CC = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ccpentium
                	LD = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ldpentium
                	INCLUDES += -I#[[$]]#(WIND_BASE)/target/h -I#[[$]]#(WIND_BASE)/target/h/wrn/coreip
		endif
		OUTCOMMAND = #[[$]]#(LD) -r -o #[[$]]#@ #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.o) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
	endif

        
	ifeq (#[[$]]#(validHost),)
	    OS = #[[$]]#(shell uname)
            #[[$]]#(error Invalid host #[[$]]#(OS) for target #[[$]]#(RTIMEARCH))
        endif
endif

ifneq (#[[$]]#(findstring ppc604Vx6.9gcc4.3.3,#[[$]]#(RTIMEARCH)),)
	DEFINES = -DRTI_VXWORKS -fno-builtin -mlongcall -DTOOL=gnu -DCPU=PPC32

	ifneq (#[[$]]#(findstring _rtp,#[[$]]#(RTIMEARCH)),)
		OUTSUFFIX = vxe 
		DEFINES += -DRTI_RTP
		
		ifneq (#[[$]]#(findstring Linux,#[[$]]#(RTIMEARCH)),)
	        	validHost = Y
			CC = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ccppc
                	LD = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ldppc
                	INCLUDES += -I#[[$]]#(WIND_USR)/h \
			            -I#[[$]]#(WIND_USR)/h/wrn/coreip
			CFLAGS += -mrtp
                        LFLAGS += -mrtp
			LIBS += -L#[[$]]#(WIND_BASE)/target/lib/usr/lib/ppc/PPC32/common
		endif
		OUTCOMMAND = #[[$]]#(LD) -r -o #[[$]]#@ #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.vxe) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
	else
        	OUTSUFFIX = so
		ifneq (#[[$]]#(findstring Linux,#[[$]]#(RTIMEARCH)),)
	        	validHost = Y
                	CC = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ccppc
                	LD = #[[$]]#(WIND_BASE)/../gnu/4.3.3-vxworks-6.9/x86-linux2/bin/ldppc
                	INCLUDES += -I#[[$]]#(WIND_BASE)/target/h -I#[[$]]#(WIND_BASE)/target/h/wrn/coreip
		endif
		OUTCOMMAND = #[[$]]#(LD) -r -o #[[$]]#@ #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.o) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
	endif

        
	ifeq (#[[$]]#(validHost),)
	    OS = #[[$]]#(shell uname)
            #[[$]]#(error Invalid host #[[$]]#(OS) for target #[[$]]#(RTIMEARCH))
        endif
endif


ifeq (#[[$]]#(RTIMEARCH),ppc604Vx5.5gcc)
        DEFINES = -DRTI_VXWORKS -mcpu=604 -G 0 -fno-builtin -mlongcall -DCPU=PPC604
        OUTSUFFIX = so
        OUTCOMMAND = #[[$]]#(LD) -r -o #[[$]]#@ #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.o) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
        ifneq (#[[$]]#(findstring sparc,#[[$]]#(RTIMEARCH)),)
	        validHost = Y
                CC = #[[$]]#(WIND_BASE)/host/sun4-solaris2/bin/ccppc
                LD = #[[$]]#(WIND_BASE)/host/sun4-solaris2/bin/ldppc
	endif
        ifneq (#[[$]]#(findstring Win,#[[$]]#(RTIMEARCH)),)
	        validHost = Y
                CC = #[[$]]#(WIND_BASE)/gnu/3.3.2/x86-win32/bin/ccppc
                LD = #[[$]]#(WIND_BASE)/gnu/3.3.2/x86-win32/bin/ldppc
                INCLUDES += -I#[[$]]#(WIND_BASE)/vthreads-2.2.2/target/vThreads/h -I#[[$]]#(WIND_BASE)/vthreads-2.2.2/target/val/h -I#[[$]]#(WIND_BASE)/vthreads-2.2.2/target/vThreads/h/netinet
                DEFINES += -DVTHREADS
	endif
        
	ifeq (#[[$]]#(validHost),)
	    OS = #[[$]]#(shell uname)
            #[[$]]#(error Invalid host #[[$]]#(OS) for target #[[$]]#(RTIMEARCH))
        endif
else
        OUTSUFFIX = out
        OUTCOMMAND = #[[$]]#{LINKER} #[[$]]#{LFLAGS} -o #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%) #[[$]]#(@:%.#[[$]]#{OUTSUFFIX}=%.o) #[[$]]#(COMMONOBJS) #[[$]]#(LIBS)
endif

ifneq (#[[$]]#(findstring WIN,#[[$]]#(RTIMEARCH)),)
        MKDIRCOMMAND = if not exist #[[$]]#* ( mkdir "#[[$]]#*" );
else
        MKDIRCOMMAND = @if [ ! -d #[[$]]#* ]; then echo "Making directory #[[$]]#*"; mkdir -p #[[$]]#* ; fi;
endif

# We actually stick the objects in a sub directory to keep your directory clean.

#[[$]]#{RTIMEARCH} : #[[$]]#(DIRECTORIES) #[[$]]#(COMMONOBJS) \
               #[[$]]#(EXEC:%=objs/#[[$]]#{RTIMEARCH}/%.o) \
               #[[$]]#(EXEC:%=objs/#[[$]]#{RTIMEARCH}/%.#[[$]]#{OUTSUFFIX})

objs/#[[$]]#{RTIMEARCH}/%.#[[$]]#{OUTSUFFIX} : objs/#[[$]]#{RTIMEARCH}/%.o 
	#[[$]]#{OUTCOMMAND}

objs/#[[$]]#{RTIMEARCH}/%.o : %${sourceFileExtension}
	#[[$]]#{CC} #[[$]]#{CFLAGS}  -o #[[$]]#@ #[[$]]#(DEFINES) #[[$]]#(INCLUDES) -c #[[$]]#<

# Rule to rebuild the generated files when the .idl file change
#[[$]]#(IDL_SRCS) #[[$]]#(IDL_HEADERS): ${global.idlFileName}.idl

ifeq (#[[$]]#(RTIMEARCH), i86Win32)
	call #[[$]]#(RTIMEHOME)/rtiddsgen/scripts/rtiddsgen.bat -replace -micro -language ${global.language} ${global.idlFileName}.idl
else
	#[[$]]#(RTIMEHOME)/rtiddsgen/scripts/rtiddsgen -replace -micro -language ${global.language} ${global.idlFileName}.idl
endif

generate: #[[$]]#(IDL_SRCS) #[[$]]#(IDL_HEADERS)

# Here is how we create those subdirectories automatically.
%.dir : 
	#[[$]]#{MKDIRCOMMAND}
