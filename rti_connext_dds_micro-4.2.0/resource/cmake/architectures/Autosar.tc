INCLUDE(CMakeForceCompiler)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n Autosar\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" The Autosar target can be used for cross-compiling for Autosar")
    MESSAGE(" targets. The compiler and options are determined based on the")
    MESSAGE(" RTIME_TARGET_NAME and the environment variables.")
    MESSAGE("\nARGUMENTS\n")
    MESSAGE(" This target interprets RTIME_TARGET_NAME as follows:")
    MESSAGE(" - If OsekCore is part of the name, binaries are built for EB tresos OsekCore")
    MESSAGE(" - If Tasking is part of the name, the Tasking compiler is used")
    MESSAGE("\nEXAMPLES\n")
    MESSAGE(" --target Autosar --name tc29xtOsekCoreTasking6.2r2\n")
    RETURN()
ENDIF()

# I wish compiler identification and testing could be used, but user variables
# such as RTIME_TARGET_NAME are not passed to try_compile(), which makes proper
# machine, OS and compiler selection impossible.
FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

IF (RTIME_TARGET_NAME MATCHES ".*OsekCore.*")
    SET(CMAKE_SYSTEM_NAME OsekCore)
ELSEIF (RTIME_TARGET_NAME MATCHES ".*VSTAR.*")
    SET(CMAKE_SYSTEM_NAME VSTAR)
ELSE()
    MESSAGE(FATAL_ERROR "No OS recognized, please select one from: OsekCore/VSTAR.")
ENDIF()

IF (RTIME_TARGET_NAME MATCHES "Tasking")
    IF (DEFINED ENV{OSEK_TOOLCHAIN_PATH})
        STRING(REPLACE "\\" "/" COMPILER_PATH $ENV{OSEK_TOOLCHAIN_PATH})
        INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/tasking.tc)
    ELSE()
        MESSAGE("Please set the OSEK_TOOLCHAIN_PATH environment variable. Example:")
        MESSAGE("set OSEK_TOOLCHAIN_PATH=c:\\TASKING\\TriCore v6.2r2")
        MESSAGE(FATAL_ERROR "")
    ENDIF()
ELSE()
    MESSAGE(FATAL_ERROR "No compiler recognized, please select one from: Tasking.")
ENDIF()

ADD_DEFINITIONS(-DOSAPI_OS_DEF_H=osapi_os_autosar.h)
ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi_cc_autosar.h)

IF (${RTI_BUILD_UNITTESTS})
    ADD_DEFINITIONS(-D__autosar__)
ENDIF()

# Multicast not supported at the moment in Autosar port
SET(RTIME_UDP_ENABLE_MULTICAST FALSE)

