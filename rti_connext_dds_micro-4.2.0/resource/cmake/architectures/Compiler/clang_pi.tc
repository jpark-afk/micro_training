SET(CMAKE_AR "${COMPILER_PATH}/ar" CACHE INTERNAL "CMAKE_AR" FORCE)
SET(CMAKE_RANLIB "${COMPILER_PATH}/ranlib" CACHE INTERNAL "CMAKE_RANLIB" FORCE)
SET(CMAKE_POSITION_INDEPENDENT_CODE TRUE)

MACRO(INCLUDE_CLANG_COMPILER_PIL version)
    set(CMAKE_C_FLAGS "-std=c99 -nostdinc -Winit-self -fstrict-aliasing \
        -fsigned-char \
        -Wmissing-declarations -Wall -Wextra -Wpedantic -Wshadow -Wcast-align \
        -Wunused -Wconversion -Wsign-conversion -Wdouble-promotion \
        -Wstrict-prototypes -Wno-long-long"
    )

    set(CMAKE_C_FLAGS_RELEASE "-O2")
    set(CMAKE_C_FLAGS_DEBUG "-g")

    set(CMAKE_CXX_FLAGS "-Winit-self -fstrict-aliasing \
        -fsigned-char \
        -Wmissing-declarations -Wall -Wextra -Wpedantic -Wshadow \
        -Wnon-virtual-dtor -Wcast-align -Wunused -Woverloaded-virtual \
        -Wconversion -Wsign-conversion  -Wdouble-promotion -Wno-long-long"
    )

    set(CMAKE_CXX_FLAGS_RELEASE "-O2")
    set(CMAKE_CXX_FLAGS_DEBUG "-g")
    
    FOREACH(language C CXX)
        SET(CMAKE_${language}_COMPILER_WORKS 1)
        SET(CMAKE_${language}_ABI_COMPILED 1)
        SET(CMAKE_${language}_COMPILE_OBJECT "<CMAKE_${language}_COMPILER> \
            <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>"
        )

        SET(CMAKE_${language}_CREATE_PREPROCESSED_SOURCE "<CMAKE_C_COMPILER> \
            <DEFINES> <INCLUDES> <FLAGS> -C -E <SOURCE> > \
            <PREPROCESSED_SOURCE>" 
            CACHE INTERNAL
            "CMAKE_C_CREATE_PREPROCESSED_SOURCE" FORCE 
        )
        SET(CMAKE_${language}_CREATE_STATIC_LIBRARY 
            "${CMAKE_AR} qc <TARGET> <OBJECTS>"
        )
    ENDFOREACH()

    SET(CMAKE_C_CREATE_SHARED_LIBRARY "${COMPILER_PATH}/clang -shared \
        ${WEAK_SYMBOL_LINKER_FLAGS} <LINK_FLAGS> -o <TARGET> <OBJECTS> \
        <LINK_LIBRARIES> "
    )
    SET(CMAKE_C_COMPILER "${COMPILER_PATH}/clang")
    SET(CMAKE_CXX_CREATE_SHARED_LIBRARY "${COMPILER_PATH}/clang++ \
        -shared ${WEAK_SYMBOL_LINKER_FLAGS} <LINK_FLAGS> -o <TARGET> \
        <OBJECTS> <LINK_LIBRARIES> "
    )
    SET(CMAKE_CXX_COMPILER "${COMPILER_PATH}/c++")
    SET(RTIME_PIL TRUE)
    ADD_DEFINITIONS(-DRTI_PIL=1)
ENDMACRO()

MACRO(INCLUDE_CLANG_COMPILER_PSL version)
    set(CMAKE_C_FLAGS "-std=c99 -Winit-self -fstrict-aliasing \
        -Wmissing-declarations -Wall -Wextra -Wpedantic -Wshadow -Wcast-align \
        -fsigned-char \
        -Wunused -Wconversion -Wsign-conversion -Wdouble-promotion"
    )

    set(CMAKE_C_FLAGS_DEBUG "-g")
    set(CMAKE_C_FLAGS_RELEASE "-O2")

    # -Wold-style-cast -Wlong-long
    set(CMAKE_CXX_FLAGS "-Winit-self -fstrict-aliasing -Wmissing-declarations \
        -fsigned-char \
        -Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor \
        -Wcast-align -Wunused -Woverloaded-virtual -Wconversion \
        -Wdouble-promotion \
        -Wno-c++11-long-long  -Wno-long-long -Wno-sign-conversion"
    )

    set(CMAKE_CXX_FLAGS_DEBUG "-g")
    set(CMAKE_CXX_FLAGS_RELEASE "-O2")

    get_filename_component(tc ${CMAKE_CURRENT_LIST_FILE} NAME)
    STRING(REGEX MATCH "(.*)-(.*)" pil_match ${tc})
    IF(pil_match)
        SET(RTIME_PIL_ARCH ${CMAKE_MATCH_1})
    ELSE()
        MESSAGE(FATAL_ERROR "No PIL found")
    ENDIF()
    SET(RTIME_PSL TRUE)
    ADD_DEFINITIONS(-DRTI_PSL=1)
ENDMACRO()

SET(CMAKE_INSTALL_RPATH "")
SET(RTIME_OBJDUMP ${COMPILER_PATH}/objdump)
SET(RTIME_OBJDUMP_OPT --disassemble-all)
SET(RTIME_OBJDUMPCHKSUM $ ${COMPILER_PATH}/objdump)
SET(RTIME_OBJDUMPCHKSUM_OPT 
    --section=.text --section=.data --section=.rodata --disassemble-all
)
SET(RTIME_OBJ_SUFFIX o)
SET(RTIME_AR_EXRACT -x)
SET(RTIME_AR  ${COMPILER_PATH}/ar)
SET(RTIME_OSAPI_COMPILER osapi_cc_clang.h)
ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi/${RTIME_OSAPI_COMPILER})
SET(OSAPI_CC_DEF_H_SET TRUE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

