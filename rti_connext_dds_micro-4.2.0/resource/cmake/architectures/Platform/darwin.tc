INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)
SET(PLATFORM_LIBS)

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")
    MESSAGE(" For Darwin (RTIME_TARGET_NAME includes Darwin)")
    MESSAGE(" the System library is sufficient")
    MESSAGE("\n")
ENDIF()

SET(_RTIME_OSAPI_PLATFORM posix)
SET(_RTIME_OSAPI_ENABLE_STRICT_POSIX FALSE)
IF (NOT DEFINED RTIME_UDP_ENABLE_MULTICAST)
    SET(RTIME_UDP_ENABLE_MULTICAST TRUE)
ENDIF()

SET(RTIME_PLATFORM_PSL
    ospsl::posix 
    ospsl::libc/string 
    ospsl::libc/malloc
    ospsl::libc/stdio
    netiopsl::udp
)

IF (NOT RTIME_CERT)
    LIST(APPEND RTIME_PLATFORM_PSL
        netiopsl::shmem/posix
    )
ENDIF()
