INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)
SET(PLATFORM_LIBS pthread)

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")
    MESSAGE(" The following libraries are included for VOS:")
    MESSAGE(" - ${PLATFORM_LIBS}")
    MESSAGE("\n")
ENDIF()

SET_PROPERTY(DIRECTORY APPEND PROPERTY 
             COMPILE_DEFINITIONS RTI_ENDIAN_BIG __SIZEOF_FLOAT__=4 __SIZEOF_DOUBLE__=8
)

SET(_RTIME_OSAPI_PLATFORM posix)
SET(_RTIME_OSAPI_ENABLE_STRICT_POSIX TRUE)
