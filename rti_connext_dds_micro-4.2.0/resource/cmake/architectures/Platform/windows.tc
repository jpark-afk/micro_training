INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)

SET(_RTIME_OSAPI_PLATFORM windows)

IF (${TARGET_HELP})
ELSE()
    ADD_DEFINITIONS(-DWIN32_LEAN_AND_MEAN)
ENDIF()

IF ((${RTIME_TARGET_NAME} MATCHES "Win32") OR
    (${RTIME_TARGET_NAME} MATCHES "Win64") OR
    (${RTIME_TARGET_NAME} MATCHES "PEvs"))
    SET(PLATFORM_LIBS ws2_32 netapi32 advapi32 user32 winmm)
ENDIF()

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")

    IF (PLATFORM_LIBS)
        MESSAGE(" The following libraries will be linked for ${RTIME_TARGET_NAME}:")
    MESSAGE(" - ${PLATFORM_LIBS}")
    ELSE()
        MESSAGE("No additional libraries will be linked for this target.")
    ENDIF()

    MESSAGE("\n")
ENDIF()

SET(RTIME_PLATFORM_PSL
    ospsl::windows
    ospsl::libc/string 
    netiopsl::udp
    ospsl::libc/stdio
)

IF (NOT RTIME_CERT)
    LIST(APPEND RTIME_PLATFORM_PSL
        netiopsl::shmem/win
    )
ENDIF()

SET(CMAKE_OBJECT_PATH_MAX 1024)
