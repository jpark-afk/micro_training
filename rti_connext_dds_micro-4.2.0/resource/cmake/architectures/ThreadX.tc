INCLUDE(CMakeForceCompiler)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n ThreadX\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" The ThreadX target can be used for cross-compiling for ThreadX")
    MESSAGE(" targets. The compiler and options are determined based on the")
    MESSAGE(" SYNERGY_PATH environment variable.")
    MESSAGE("\nEXAMPLES\n")
    MESSAGE(" --target ThreadX --name cortexm4ThreadX5.8gcc4.9.3\n")
ENDIF()

FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

SET(CMAKE_C_COMPILER   arm-none-eabi-gcc "--specs=nosys.specs --specs=nano.specs")
SET(CMAKE_CXX_COMPILER arm-none-eabi-g++ "--specs=nosys.specs --specs=nano.specs")

SET(CMAKE_SYSTEM_NAME ThreadX)

IF (NOT ${TARGET_HELP})
    IF (${RTIME_TARGET_NAME} MATCHES "gcc") 
        INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/armgcc.tc)
    ELSE()
        MESSAGE(FATAL_ERROR "Unknown compiler specified in ${RTIME_TARGET_NAME}")
    ENDIF()
ELSE()
    INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/armgcc.tc)
ENDIF()

ADD_DEFINITIONS(-DOSAPI_OS_DEF_H=osapi_os_threadx.h)

