SET(CMAKE_SYSTEM_NAME QNX)
SET(CMAKE_SYSTEM_VERSION 6.6.0)

# This tool-chain file assumes that qnx660/qnx660-env.sh has been sourced first 

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/qnx.tc)

SET(CMAKE_CXX_COMPILER $ENV{QNX_HOST}/usr/bin/ntoarmv7-g++)
SET(CMAKE_C_COMPILER $ENV{QNX_HOST}/usr/bin/ntoarmv7-gcc)

SET(CMAKE_C_FLAGS_RELEASE "-DNDEBUG" CACHE INTERNAL "CMAKE_C_FLAGS_RELEASE" FORCE)
SET(CMAKE_CXX_FLAGS_RELEASE "-DNDEBUG" CACHE INTERNAL "CMAKE_CXX_FLAGS_RELEASE" FORCE)

SET(RTIME_OSAPI_PLATFORM posix)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)


