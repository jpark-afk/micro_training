SET(CMAKE_SYSTEM_NAME Linux)

SET(COMPILER_PREFIX "aarch64-none-linux-gnu-")
SET(CMAKE_C_COMPILER aarch64-none-linux-gnu-gcc)
SET(CMAKE_CXX_COMPILER aarch64-none-linux-gnu-g++)
SET(RTIME_PLATFORM_SUPPORTS_ZCOPY_V2 TRUE CACHE BOOL "Platform supports ZCOPYv2")
SET(RTIME_INCLUDE_PSL_PSK_SUPPORT TRUE CACHE BOOL "Enable PSL PSK")

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/armgcc_pi.tc)

INCLUDE_ARMGCC_COMPILER_PSL("11.3.1")

SET(RTIME_OSAPI_PLATFORM posix)

SET(RTIME_OSAPI_ENABLE_STRICT_POSIX FALSE)
IF (NOT DEFINED RTIME_UDP_ENABLE_MULTICAST)
    SET(RTIME_UDP_ENABLE_MULTICAST TRUE)
ENDIF()


