SET(CMAKE_SYSTEM_NAME Linux)

SET(COMPILER_PATH "/usr/bin" CACHE INTERNAL "COMPILER_PATH" FORCE)

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc_pi.tc)

INCLUDE_GCC_COMPILER_PSL("7.3.0")
ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi/osapi_cc_gcc.h
                -DOSAPI_OS_DEF_H=osapi_os_posix.h)

SET(RTIME_OSAPI_PLATFORM posix)
SET(RTIME_OSAPI_ENABLE_STRICT_POSIX FALSE)
SET(RTIME_INCLUDE_DGRAM TRUE)
SET(RTIME_PSL_SUBMODULES osapi_posix netio_notif_mechanism)

IF (RTIME_PSL_NETIO)
    LIST(APPEND RTIME_PSL_SUBMODULES ${RTIME_PSL_NETIO})
ELSEIF(NOT RTIME_NO_PSL_NETIO AND RTIME_INCLUDE_DGRAM)
    LIST(APPEND RTIME_PSL_SUBMODULES netio_dgram_udpv4)
    ADD_DEFINITIONS(-DHAVE_SOCKET_API)
ENDIF()

IF (NOT DEFINED RTIME_UDP_ENABLE_MULTICAST)
    SET(RTIME_UDP_ENABLE_MULTICAST TRUE)
ENDIF()

SET(RTIME_EXCLUDE_CPP FALSE)

SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fsanitize=thread")
SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsanitize=thread")