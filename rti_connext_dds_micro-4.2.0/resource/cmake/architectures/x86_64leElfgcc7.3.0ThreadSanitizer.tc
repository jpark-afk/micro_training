set(CMAKE_SYSTEM_NAME RTIME_Linux_PI)

# Set the default build to include CPP
SET(RTIME_EXCLUDE_CPP FALSE)

SET(COMPILER_PATH "/usr/bin" CACHE INTERNAL "COMPILER_PATH" FORCE)

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc_pi.tc)

INCLUDE_GCC_COMPILER_PIL("7.3.0")

ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi_cc_gcc.h)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n ${CMAKE_CURRENT_LIST_FILE}\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE("FLAGS\n")
    MESSAGE("CMAKE_C_FLAGS=${CMAKE_C_FLAGS}\n")
    MESSAGE("CMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}\n")
    MESSAGE("CMAKE_CXX_FLAGS_RELEASE=${CMAKE_CXX_FLAGS_RELEASE}\n")
    MESSAGE("CMAKE_CXX_FLAGS_DEBUG=${CMAKE_CXX_FLAGS_DEBUG}\n")
    MESSAGE("\nARGUMENTS\n")
    MESSAGE("\nEXAMPLES\n")
    RETURN()
ENDIF()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fsanitize=thread")
SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsanitize=thread")