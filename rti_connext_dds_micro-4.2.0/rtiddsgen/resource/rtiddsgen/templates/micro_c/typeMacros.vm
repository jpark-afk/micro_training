#macro(defineFnTypeInitializeMicroMicro $member)
RTI_BOOL
${member.nativeFQNameInModule}_initialize(${member.nativeFQNameInModule}* sample)
{
    if (sample == NULL)
    {
        return RTI_FALSE;
    }
    
#if($member.constructKind.equals("enum"))
#* 21may2014,as: can't this be changed to initialize
 * the enum to its first defined value?
 *#   
    /* The following method initializes the enum value to zero. However,
    * some enumerations may not have a member with the value zero. In such
    * cases, it may be desirable to modify the generated code to use a valid
    * enumeration member instead.
    */
    CDR_Primitive_init_enum((CDR_Enum*) sample);
#else
#*--*##if($member.baseTypeFQName)
    if (!${member.baseTypeFQName}_initialize((${member.baseTypeFQName}*)sample))
    {
        return RTI_FALSE;
    }
#*--*##end
#*--*##if($member.constructKind.equals("const"))
    #initialize_memberMicroMicro($member)   
#*--*##else
    #initializeMicroMicro($member)## Call to a macro to initialize funtion
#*--*##end
#end
    return RTI_TRUE;
}
#end

#macro(defineFnTypeFinalizeMicroMicro $member)
#*-****************************************************************-*#
#* 21may2014,as: this operation should probably be void, since
 * its return value is hard-coded.
 * 30mar2015,as: operation now returns RTI_FALSE when invoked with
   (sample == NULL).
 *#
RTI_BOOL
${member.nativeFQNameInModule}_finalize(${member.nativeFQNameInModule}* sample)
{
    if (sample == NULL)
    {
        return RTI_FALSE;
    }
    
#if($member.baseTypeFQName)
    ${member.baseTypeFQName}_finalize((${member.baseTypeFQName}*)sample);
#end
    #finalizeMicroMicro($member.memberFieldMapList)## Call to a macro to finalize
    return RTI_TRUE;
}
#end

#macro(defineFnTypeCreateMicroMicro $member)
${member.nativeFQNameInModule} *
${member.nativeFQNameInModule}_create(void)
{
    ${member.nativeFQNameInModule}* sample;
    OSAPI_Heap_allocate_struct(&sample, ${member.nativeFQNameInModule});
    if (sample != NULL)
    {
        if (!${member.nativeFQNameInModule}_initialize(sample))
        {
            OSAPI_Heap_free_struct(sample);
            sample = NULL;
        }
    }
    return sample;
}
#end

#macro(defineFnTypeDeleteMicroMicro $member)
${envMap.POUND_CHAR}ifndef RTI_CERT
void
${member.nativeFQNameInModule}_delete(${member.nativeFQNameInModule}* sample)
{
    if (sample != NULL)
    {
        /* ${member.nativeFQNameInModule}_finalize() always 
           returns RTI_TRUE when called with sample != NULL */
        ${member.nativeFQNameInModule}_finalize(sample);
        OSAPI_Heap_free_struct(sample);
    }
}
${envMap.POUND_CHAR}endif
#end

#macro(defineFnTypeCopyMicroMicro $member)
RTI_BOOL
${member.nativeFQNameInModule}_copy(${member.nativeFQNameInModule}* dst,const ${member.nativeFQNameInModule}* src)
{        
    if ((dst == NULL) || (src == NULL))
    {
        return RTI_FALSE;
    }
#if($member.constructKind.equals("enum"))
    CDR_Primitive_copy_enum((CDR_Enum *)dst, (CDR_Enum *)src);
#else
#*--*##if($member.baseTypeFQName)
