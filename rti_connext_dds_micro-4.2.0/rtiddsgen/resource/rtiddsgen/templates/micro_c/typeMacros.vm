##------------------------------------------------------------------------------
## Macro to intialize a member with an alias
##------------------------------------------------------------------------------
#macro(initUserMicroMicro $member )
    if (!${member.nativeTypeFQName}_initialize(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end))
    {
        return RTI_FALSE;
    }
#end

##------------------------------------------------------------------------------
## Macro to intialize arrays or sequences
##------------------------------------------------------------------------------
#macro(initArrayofSeqMicroMicro $member)
    {
        RTI_INT32 i;
        for (i = 0; i < #addDimensionMultiplicationMicroMicro($member) ; i++)
        {
#initSeqMicroMicro($member)
        }
    }
#end

##------------------------------------------------------------------------------
## Macro to intialize sequences
##------------------------------------------------------------------------------
#macro(initSeqMicroMicro $member)
#if($member.typeKind.equals("user"))
    if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#if($member.dimensionList)[i]#end#else${member.samplePoint}#if($member.dimensionList)[i]#end#end))
    {
        return RTI_FALSE;
    }
    if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#if($member.dimensionList)[i]#end#else${member.samplePoint}#if($member.dimensionList)[i]#end#end, ($member.seqSize)))
    {
        return RTI_FALSE;
    }
#else
#if($member.dimensionList)
        if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}[i]#else&(*${member.samplePoint})[i] #end))
        {
            return RTI_FALSE;
        }
        if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}[i]#else&(*${member.samplePoint})[i] #end,($member.seqSize)#if($member.strSize),(${member.strSize})#end))
        {
            return RTI_FALSE;
        }
#else
    if (!${member.sequenceInitMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint} #end))
    {
        return RTI_FALSE;
    }
    if (!${member.sequenceSetMaxMethod}(#if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint} #end,($member.seqSize)#if($member.strSize),(${member.strSize})#end))
    {
        return RTI_FALSE;
    }
#end
#end
#end

##------------------------------------------------------------------------------
## Macro to intialize array
##------------------------------------------------------------------------------

#macro(initArrayMicroMicro $member)
#if($member.typeKind.equals("user"))
    {
        int i = 0;
        $member.nativeTypeFQName* elem =
            ($member.nativeTypeFQName*) #if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end[0];

        for (i = 0; i < #addDimensionMultiplicationMicroMicro($member); ++i, ++elem)
        {
            if (!${member.nativeTypeFQName}_initialize(elem))
            {
                return RTI_FALSE;
            }
        }
    }
#elseif($member.strSize)
    if (!CDR_StringArray_initialize(#if($member.name.equals(""))(*sample)#else${member.samplePoint}${member.name}#end,
        #addDimensionMultiplicationMicroMicro($member),(${member.strSize}), ${member.typeEnum}))
    {
        return RTI_FALSE;
    }
#else
    CDR_Primitive_init_array(
        #if($member.name.equals(""))(*sample)#else${member.samplePoint}${member.name}#end, (#addDimensionMultiplicationMicroMicro($member)*${member.elementSize}));
#end
#end

