## Macro finalizeArray
##------------------------------------------------------------------------------
#macro(finalizeArrayMicroMicro $member)
#if($member.typeKind.equals("user"))
    {
        int i = 0;
        $member.nativeTypeFQName* elem =
            ($member.nativeTypeFQName*) #if(!$member.name.equals(""))${member.sampleRef}${member.name}#else${member.samplePoint}#end[0];

