static DDS_DataRepresentationId_t ${member.nativeFQNameInModule}_gv_XCDR2 = DDS_XCDR2_DATA_REPRESENTATION;
#elseif ($member.dataRepresentationMask == 4) ## XCDRv2 
static DDS_DataRepresentationId_t ${member.nativeFQNameInModule}_gv_AutoRepresentation = DDS_XCDR2_DATA_REPRESENTATION;
