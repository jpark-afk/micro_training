#macro(defineFnFlatDataSerializeMicroMicro $member)
RTI_PRIVATE RTI_BOOL
${member.nativeFQNameInModule}_flatdata_serialize(struct DDS_TypePlugin *plugin,
                                             struct CDR_Stream_t *stream,
                                             const void *void_sample,
                                             DDS_InstanceHandle_t *destination)
{
    RTIXCdrStream xcdrStream;
    ${member.nativeFQNameInModule}* sample = (${member.nativeFQNameInModule}*)void_sample;
    struct DDS_TypePluginBuffer *tp_buffer = OSAPI_Compiler_reinterpret_cast(
                                                struct DDS_TypePluginBuffer*,
                                                stream->start_ptr);
    ${member.nativeFQNameInModule} *flat_data_ptr =
                        const_cast<${member.nativeFQNameInModule} *>(sample);
    UNUSED_ARG(plugin);
    UNUSED_ARG(destination);

    flat_data_ptr->initialize_stream(xcdrStream, 0, flat_data_ptr->buffer_size());

	/* At this point, the expection is that the encapsulation is already set. It can only
	 * by either FINAL or MUTABLE. By default it is FINAL and during the creation of a mutable type
	 * sets the encapsulation to MUTABLE. Appendable is not currently supported.
     */
    /* Set the data_pbuffer to be the actual flat data sample (since it is in serialized format)
     */
    tp_buffer->data_pbuf.buffer = (char*)void_sample;
    tp_buffer->data_pbuf.max_length = xcdrStream._bufferLength;

    /* Increment the stream pointer to make it seem as if it was "serialized" */
    stream->buff_ptr += xcdrStream._bufferLength;

    return RTI_TRUE;
}
#end

#macro(defineFnFlatDataDeserializeMicroMicro $member)
RTI_PRIVATE RTI_BOOL
${member.nativeFQNameInModule}_flatdata_deserialize(struct DDS_TypePlugin *plugin,
                                               void *void_sample,
                                               struct CDR_Stream_t *stream,
                                               DDS_InstanceHandle_t *source)
{
    RTI_UINT32 length_of_serialized_payload = 0;

    UNUSED_ARG(plugin);
    UNUSED_ARG(source);

    length_of_serialized_payload = stream->length - (RTI_UINT32)(stream->buff_ptr - stream->real_buff);

    /* Because we deserialize the encapsulation (and thus advancing the stream)
     * we need to subtract 4 bytes (encapsulation + encapsulation options)
     * from the current position.
     */

    OSAPI_Memory_copy(void_sample, stream->buff_ptr - 4, length_of_serialized_payload + 4);

    stream->buff_ptr += length_of_serialized_payload;

    return RTI_TRUE;
}
#end

#macro(defineFnFlatDataDeserializeKeyMicroMicro $member)
RTI_PRIVATE RTI_BOOL
${member.nativeFQNameInModule}_flatdata_deserialize_key(struct DDS_TypePlugin *plugin,
                                                    void *void_sample,
                                                    struct CDR_Stream_t *stream,
                                                    DDS_InstanceHandle_t *source)
{
	UNUSED_ARG(plugin);
	UNUSED_ARG(source);

	RTI_UINT32 length_of_serialized_payload = 0;
	length_of_serialized_payload = stream->length - (RTI_UINT32)(stream->buff_ptr - stream->real_buff);

    struct CDR_Stream_t temporary_stream_used_for_deserialization;
    struct CDR_Stream_t * md5stream = (struct CDR_Stream_t*)void_sample;
	DDS_KeyHash_t keyhash;

    CDR_Stream_initialize(&temporary_stream_used_for_deserialization);
   	temporary_stream_used_for_deserialization.need_byte_swap = stream->need_byte_swap;
   	temporary_stream_used_for_deserialization.endian         = stream->endian;

#*----*##if($node.extensibility.equals("FINAL_EXTENSIBILITY"))
    /* The first 4 bytes flat data samples is the encapsulation header
     * Note. the serialized_size does not include the encapsulation header
     */
    unsigned int size = ${node.nativeFQNameInModule}::Offset::serialized_size(0);
#*----*##else

    /* Because the encapsulation has already been deserialized,
     * the buff_ptr now points to the beginning of the mutable sample
     * so we don't need to pass in any any offset to
     * RTIXCdrFlatSample_getMutableSampleSize
     */
    unsigned int size = static_cast<unsigned int>(
        RTIXCdrFlatSample_getMutableSampleSize(
            reinterpret_cast<const unsigned char *>(stream->buff_ptr),
            0));
#*----*##end

	/* Note at this point, the encapsulation has ALREADY been deserialized */
    if (!CDR_Stream_set_buffer(
            &temporary_stream_used_for_deserialization,
            ((char*)stream->buff_ptr),
            size))
    {
    	return RTI_FALSE;
    }

    ${member.nativeFQNameInModule}PlainHelper *plain_helper = NULL;
    plain_helper = (${member.nativeFQNameInModule}PlainHelper*)plugin->property.flat_data_plain_helper;

    if (!XCDR_GenericTypePlugin_deserialize_key(plugin,
    								      plain_helper,
    								      &temporary_stream_used_for_deserialization,
    								      NULL))
 	{
 		return RTI_FALSE;
 	}

    stream->buff_ptr += length_of_serialized_payload;

    if (!XCDR_GenericTypePlugin_instance_to_keyhash(plugin, md5stream,
                            &keyhash, plain_helper,
                            DDS_ENCAPSULATION_ID_XCDR2_F_BE))
    {
    	return RTI_FALSE;
    }

    /* we copy the keyhash as the first 16 bytes of ths md5stream passed in a special case
     * to this function. Regardless of the keysize, we will always allocate at least 16 bytes
     */
    OSAPI_Memory_copy(md5stream->real_buff, &keyhash, 16);

    return RTI_TRUE;
}
#end
