#macro(defineFnRegisterTypeExMicroMicro $member)
RTI_PRIVATE DDS_Boolean
${member.nativeFQNameInModule}_on_type_registered(struct DDS_TypeImpl* type_impl)
{
    struct RTIXCdrInterpreterPrograms *programs = NULL;
    struct RTIXCdrInterpreterProgramsGenProperty programProperty =
    RTIXCdrInterpreterProgramsGenProperty_INITIALIZER;

    programProperty.resolveAlias = RTI_XCDR_TRUE;
    programProperty.inlineStruct = RTI_XCDR_TRUE;
    programProperty.optimizeEnum = RTI_XCDR_TRUE;

    programs = RTIXCdrInterpreterPrograms_new(
#*--------*##if($node.languageBinding.equals("FLAT_DATA"))
            (RTIXCdrTypeCode *)${node.nativeFQNameInModule}PlainHelper_get_typecode(),
#*--------*##else
            (RTIXCdrTypeCode *)${node.nativeFQNameInModule}_get_typecode(),
#*--------*##end
	    &programProperty,
        RTI_XCDR_PROGRAM_MASK_TYPEPLUGIN);

    if (programs == NULL)
    {
    	return DDS_BOOLEAN_FALSE;
    }


#*--*##if($node.languageBinding.equals("FLAT_DATA"))
	{
		${member.nativeFQNameInModule}PlainHelper* plain_helper = NULL;
		OSAPI_Heap_allocate_struct(&plain_helper, ${member.nativeFQNameInModule}PlainHelper);
		${member.nativeFQNameInModule}PlainHelper_initialize(plain_helper);
		DDS_TypeImpl_set_sample(type_impl, plain_helper);
	}
#*--*##end

