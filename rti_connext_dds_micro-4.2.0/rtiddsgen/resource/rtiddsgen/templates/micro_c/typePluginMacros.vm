#macro(defineFnTypePluginCreateSampleMicroMicro $member)
RTI_BOOL
${member.nativeFQNameInModule}Plugin_create_sample(
    struct DDS_TypePlugin *plugin,
    void **sample)
{
    UNUSED_ARG(plugin);

#if($member.languageBinding.equals("FLAT_DATA"))
    *sample = ${member.nativeFQNameInModule}::create_data();
#else
    *sample = (void *) ${member.nativeFQNameInModule}_create();
#end
    return (*sample != NULL);
}
#end

#macro(defineFnTypePluginDeleteSampleMicroMicro $member)
RTI_BOOL
${member.nativeFQNameInModule}Plugin_delete_sample(
    struct DDS_TypePlugin *plugin,
    void *sample)
{
    UNUSED_ARG(plugin);

${envMap.POUND_CHAR}ifndef RTI_CERT
    /* ${member.nativeFQNameInModule}_delete() is a void function
     * which expects (sample != NULL). Since
     * ${member.nativeFQNameInModule}Plugin_delete_sample
     * is an internal function, sample is assumed to be a valid pointer
     */
#if($member.languageBinding.equals("FLAT_DATA"))
      ${member.nativeFQNameInModule}TypeSupport::delete_data((${member.nativeFQNameInModule}*)sample);
#else
    ${member.nativeFQNameInModule}_delete((${member.nativeFQNameInModule} *) sample);
#end
${envMap.POUND_CHAR}endif

    return RTI_TRUE;
}
#end

