## This function is used by the TypePlugin interface to initialize samples
## from a memory manager's create_sample function

MUST_CHECK_RETURN RTI_PRIVATE RTI_BOOL
${member.nativeFQNameInModule}TypePlugin_initialize_sample(struct DDS_TypePlugin *plugin, void *buffer)
{
    #if(!$member.languageBinding.equals("FLAT_DATA"))
        UNUSED_ARG(plugin);
        return ${node.nativeFQNameInModule}_initialize((${node.nativeFQNameInModule}*)buffer);
    #else

        UNUSED_ARG(plugin);
        #if($node.extensibility.equals("MUTABLE_EXTENSIBILITY"))

        if (!RTIXCdrFlatData_initializeMutableSample((unsigned char*) buffer))
        {
        	return RTI_FALSE;
        }

        return RTI_TRUE;

        #else
        ${node.nativeFQNameInModule}* tdata = (${node.nativeFQNameInModule}*) buffer;
        struct RTIXCdrInterpreterPrograms *programs =
            rti::xcdr::type_programs<${node.nativeFQNameInModule}::Base>::get();
        UNUSED_ARG(plugin);
        if (!RTIXCdrFlatData_initializeSample(
                    (char *)tdata->get_root_buffer(),
                    ${node.nativeFQNameInModule}::Offset::serialized_size(0),
                    programs))
        {
            return RTI_FALSE;
        }
        return RTI_TRUE;

        #end

    #end
}

RTI_PRIVATE RTI_UINT32
${member.nativeFQNameInModule}_get_user_sample_size(
    struct DDS_TypePlugin *tp)
{
    #if($member.languageBinding.equals("FLAT_DATA"))

        if (!tp->is_max_serialized_size_set)
        {
        	RTI_UINT32 serialized_size = XCDRv2_StreamPlugin_get_serialized_sample_size(tp, NULL, 0) + RTI_XCDR_ENCAPSULATION_HEADER_SIZE;
        	tp->is_max_serialized_size_set = RTI_TRUE;
        	tp->max_serialized_size = serialized_size;
        	return serialized_size;
        }
        else
        {
        	return tp->max_serialized_size;
        }

    #else
        UNUSED_ARG(tp);
        #if($envMap.language.equals("Cpp"))
            return sizeof(${member.nativeFQNameInModule});
        #else
            return sizeof(struct ${member.nativeFQNameInModule});
        #end
    #end
}

