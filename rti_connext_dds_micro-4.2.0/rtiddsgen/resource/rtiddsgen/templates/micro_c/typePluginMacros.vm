##******************************************************************************
## Macro to Serialize/Deserialize
##******************************************************************************

#macro(serializeMicroMicro $memberFieldMapList $key)
#*--*##foreach($member in $memberFieldMapList)
#if($node.constructKind.equals("union"))
#initCasesMicroMicro($member)
#end
#if($member.directive)
#printCopyDirectiveNoDeclarationMicroMicro($member)
#else
#serializeMemberMicroMicro($member $key)
#end
#if($node.constructKind.equals("union"))
        } #if($member.label.get(0)!="(default)")break #end;
#end
#*--*##end
#end

#macro(deserializeMicroMicro $memberFieldMapList $key)
#*--*##foreach($member in $memberFieldMapList)
#if($node.constructKind.equals("union"))
#initCasesMicroMicro($member)
#end
#if($member.directive)
#printCopyDirectiveNoDeclarationMicroMicro($member)
#else
#deserializeMemberMicroMicro($member $key)
#end
#if($node.constructKind.equals("union"))
        } #if($member.label.get(0)!="(default)")break #end;
#end
#*--*##end
#end

##------------------------------------------------------------------------------
##Macro to Serialize/Deserialize a member of a struct
##------------------------------------------------------------------------------

#macro(serializeMemberMicroMicro $member $key)
#*--*##if($member.dimensionList && $member.seqSize)
#*----*##serializeArrayofSeqMicroMicro($member $key)
#*--*##elseif($member.dimensionList)
#*----*##serializeArrayMicroMicro($member $key)
#*--*##elseif($member.seqSize)
#*----*##serializeSeqMicroMicro($member $key)
#*--*##elseif($member.typeKind.equals("user"))
#*----*##serializeUserMicroMicro($member $key)
#*--*##else
#*----*##serializePrimitivesMicroMicro($member)
#*--*##end
#end

#macro(deserializeMemberMicroMicro $member $key)
#*--*##if($member.dimensionList && $member.seqSize)
#*----*##deserializeArrayofSeqMicroMicro($member $key)
#*--*##elseif($member.dimensionList)
#*----*##deserializeArrayMicroMicro($member $key)
#*--*##elseif($member.seqSize)
#*----*##deserializeSeqMicroMicro($member $key)
#*--*##elseif($member.typeKind.equals("user"))
#*----*##deserializeUserMicroMicro($member $key)
#*--*##else
#*----*##deserializePrimitivesMicroMicro($member)
#*--*##end
#end

##------------------------------------------------------------------------------
##Macro to Serialize/Deserialize an array of sequences
##------------------------------------------------------------------------------
#macro(serializeArrayofSeqMicroMicro $member $key)
   {
        RTI_UINT32 i;
        for (i = 0; i<  #addDimensionMultiplicationMicroMicro($member); ++i)
        {
#serializeSeqMicroMicro($member $key)
        }
   }
#end

#macro(deserializeArrayofSeqMicroMicro $member $key)
   {
        RTI_UINT32 i;
        for (i = 0; i<  #addDimensionMultiplicationMicroMicro($member); i++)
        {
#deserializeSeqMicroMicro($member $key)
        }
   }
#end

