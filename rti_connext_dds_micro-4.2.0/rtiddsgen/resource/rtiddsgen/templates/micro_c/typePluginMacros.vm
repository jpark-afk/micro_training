##******************************************************************************
## Macro to AligmentMaxSize
##******************************************************************************

#macro(CreateCurrentAligmentMaxSizeMicroMicro $memberFieldMapList)
#*--*##foreach($member in $memberFieldMapList)
#if($member.directive)
#printCopyDirectiveNoDeclarationMicroMicro($member)
#else
#CreateCurrentAligmentMaxSizeMemberMicroMicro($member)
#end
#*--*##end## We need an intro before to separate each member
#end


#macro(CreateCurrentAligmentMaxSizeMemberMicroMicro $member)
#*----*##if($member.dimensionList && $member.seqSize)
#*------*##getMaxSizeArrayofSeqMicroMicro($member "sample")
#*----*##else
    current_alignment += #aligmentMaxSizeMemberMicroMicro($member);

#end
#end

#macro(aligmentMaxSizeMemberMicroMicro $member)
#*----*##if($member.seqSize)#*
--------*##getMaxSizeSeqMicroMicro($member "sample" "current_alignment")#*
------*##elseif($member.dimensionList)#*
--------*##getMaxSizeSerialized_PrimitiveArrayMicroMicro($member "sample")#*
------*##elseif($member.typeKind.equals("user"))#*
--------*##getUserMaxSizeSerializedMicroMicro($member)#*
------*##else#*
--------*#${member.elementSizeMethod}(
#*------*#        current_alignment#if($member.strSize), ($member.strSize)+1#end)#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of an array of sequences
##------------------------------------------------------------------------------

#macro(getMaxSizeArrayofSeqMicroMicro $member $key)
{
        RTI_UINT32 i, maxSize = current_alignment;

        for (i = 0; i <#addDimensionMultiplicationMicroMicro($member); i++) {
#*--*##if($member.typeKind.equals("user"))
            maxSize += PluginHelper_get_max_size_serialized_sequence(
                plugin,
                maxSize, ($member.seqSize),
                ${member.nativeTypeFQName}_get_serialized_${key}_size);
#*--*##elseif($member.strSize)
            maxSize += CDR_get_max_size_serialized_string_sequence(
                maxSize, ($member.seqSize), ($member.strSize), ${member.typeEnum});

#*--*##else
            maxSize += CDR_get_max_size_serialized_primitive_sequence(
                maxSize, ($member.seqSize), ${member.typeEnum});

#*--*##end
        }

        current_alignment +=  (maxSize - current_alignment) ;
    }
#end

##------------------------------------------------------------------------------
## Macro to getMaxSize of a sequence
##------------------------------------------------------------------------------

#macro(getMaxSizeSeqMicroMicro $member $key $var)
#*--*##if($member.typeKind.equals("user"))
        PluginHelper_get_max_size_serialized_sequence(
        plugin,
        $var, ($member.seqSize),
         ${member.nativeTypeFQName}_get_serialized_${key}_size)#*
----*##elseif($member.strSize)
CDR_get_max_size_serialized_string_sequence(
        $var,(${member.seqSize}),($member.strSize),${member.typeEnum}) #*
----*##else
CDR_get_max_size_serialized_primitive_sequence(
        $var, (${member.seqSize}), ${member.typeEnum})#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of a alias(typedef)
##------------------------------------------------------------------------------

#macro(getUserMaxSizeSerializedMicroMicro $member)
${member.nativeTypeFQName}_get_serialized_sample_size(
        plugin,current_alignment)#*
*##end


##------------------------------------------------------------------------------
## Macro to getMaxSize of a array
##------------------------------------------------------------------------------
#macro(getMaxSizeSerialized_PrimitiveArrayMicroMicro $member $key)
#*--*##if($member.typeKind.equals("user"))
        PluginHelper_get_max_size_serialized_array(
        plugin,
        current_alignment, #addDimensionMultiplicationMicroMicro($member),
        ${member.nativeTypeFQName}_get_serialized_${key}_size)#*
----*##elseif($member.strSize)
CDR_get_max_size_serialized_string_array(
        current_alignment, #addDimensionMultiplicationMicroMicro($member), ($member.strSize), ${member.typeEnum})#*
----*##else
CDR_get_max_size_serialized_primitive_array(
        current_alignment, #addDimensionMultiplicationMicroMicro($member), ${member.typeEnum})#*
----*##end
#end


##------------------------------------------------------------------------------
## Macro to getMaxSize of an  Union
##------------------------------------------------------------------------------
#macro(createCurrentAligmentMaxSizeUnionMicroMicro $node)
#CreateCurrentAligmentMaxSizeMemberMicroMicro($node.unionDiscriminatorMap)
#foreach($member in $node.memberFieldMapList)
#*----*##if($member.dimensionList && $member.seqSize)
    {
        RTI_UINT32 i;
        unsigned int maxSize = current_alignment;

        for (i = 0; i < #addDimensionMultiplicationMicroMicro($member); i++)
        {
            maxSize += #getMaxSizeSeqMicroMicro($member "sample" "maxSize");
        }

        temp = maxSize - current_alignment;
    }
#*----*##else
    temp = #aligmentMaxSizeMemberMicroMicro($member);
#*----*##end
    if (union_max_size_serialized < temp) {
        union_max_size_serialized = temp;
    }
#end
#end

