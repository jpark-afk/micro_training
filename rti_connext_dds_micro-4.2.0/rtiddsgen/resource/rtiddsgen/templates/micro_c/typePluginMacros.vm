##------------------------------------------------------------------------------------------------------------------------------
## interpreted v1 encapsulaion plugin (for flat and non-flat)
##------------------------------------------------------------------------------------------------------------------------------

#macro(defineTypePluginFunctionsForInterpretedEncapsulationCDRv2MicroMicro $member)

#if($member.languageBinding.equals("FLAT_DATA") && $member.hasKey)

MUST_CHECK_RETURN DDSCDllExport RTI_PRIVATE RTI_BOOL
${member.nativeFQNameInModule}_instance_to_keyhash_flat_data(
        struct NDDS_Type_Plugin *plugin,
        struct CDR_Stream_t *md5stream,
        DDS_KeyHash_t *key_hash,
        const void *instance,
        DDS_EncapsulationId_t id)
{
        struct CDR_Stream_t temporary_stream_used_for_deserialization;

        CDR_Stream_initialize(&temporary_stream_used_for_deserialization);

${envMap.POUND_CHAR}ifdef RTI_ENDIAN_LITTLE
        temporary_stream_used_for_deserialization.endian = RTI_CDR_ENDIAN_LITTLE;
${envMap.POUND_CHAR}else
        temporary_stream_used_for_deserialization.endian = RTI_CDR_ENDIAN_BIG;
${envMap.POUND_CHAR}endif

        temporary_stream_used_for_deserialization.need_byte_swap = RTI_FALSE;

        if (plugin->big_endian)
        {
            CDR_Stream_set_endianess(&temporary_stream_used_for_deserialization,RTI_TRUE);
        }
        else
        {
            CDR_Stream_set_endianess(&temporary_stream_used_for_deserialization,RTI_FALSE);
        }

#*----*##if($node.extensibility.equals("FINAL_EXTENSIBILITY"))

        /* The first 4 bytes flat data samples is the encapsulation header
         * Note. the serialized_size does not include the encapsulation header
         */
        unsigned int size = ${node.nativeFQNameInModule}::Offset::serialized_size(0);

#*----*##else

		/* The instance points the beginning of the serialized sample
		 * so we need to pass in the offset RTI_XCDR_ENCAPSULATION_HEADER_SIZE
		 * so that this function correctly points to the beginning of the D Header
		 */
        unsigned int size = static_cast<unsigned int>(
            RTIXCdrFlatSample_getMutableSampleSize(
                reinterpret_cast<const unsigned char *>(instance),
                RTI_XCDR_ENCAPSULATION_HEADER_SIZE));

#*----*##end

        if (!CDR_Stream_set_buffer(
                &temporary_stream_used_for_deserialization,
                ((char*)instance) + RTI_XCDR_ENCAPSULATION_HEADER_SIZE,
                size))
        {
        	return RTI_FALSE;
        }

        ${member.nativeFQNameInModule}PlainHelper *plain_helper = NULL;
    	plain_helper = (${member.nativeFQNameInModule}PlainHelper*)plugin->property.flat_data_plain_helper;

        if (!XCDR_Interpreter_serialized_sample_to_key(plugin,
                plain_helper,
                &temporary_stream_used_for_deserialization,
                RTI_FALSE,
                RTI_TRUE,
                plugin->current_encapsulation))
        {
    		return RTI_FALSE;
        }
        return XCDR_GenericTypePlugin_instance_to_keyhash(plugin,
                                        md5stream, key_hash, plain_helper,id);
}

#end

