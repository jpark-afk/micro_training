#macro(multiplicationIfNeededMicroMicro $index $member)
#set ( $lastone = $member.dimensionList.size() - 1 )
#if( $index <= $lastone)*#end
#end

#macro(addDimensionMultiplicationMicroMicro $member)#if($member.dimensionList)#set($index = 0)#foreach($element in $member.dimensionList)#*
*#($element)#set( $index = $index + 1 )#multiplicationIfNeededMicroMicro($index $member)#end#end#end

#macro(commaIfNeededMicroMicro $index $size)
