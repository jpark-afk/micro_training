INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)

SET(PLATFORM_LIBS m socket)
SET(_RTIME_OSAPI_PLATFORM posix)

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")
    MESSAGE(" For QNX (RTIME_TARGET_NAME includes QNX) the ")
    MESSAGE(" following libraries are included:")
    MESSAGE(" - ${PLATFORM_LIBS}")
    MESSAGE("\n")
ENDIF()

SET(_RTIME_OSAPI_PLATFORM posix)
SET(_RTIME_OSAPI_ENABLE_STRICT_POSIX TRUE)

SET(RTIME_PLATFORM_PSL
    ospsl::posix
    ospsl::libc/string
    ospsl::libc/malloc
    netiopsl::udp
    ospsl::libc/stdio
    pskpsl::transform/openssl3
    pskpsl::file_tracker/posix
)

# if the platform supports zcopy v2 and the user has not explictly enabled/disabled zcopyv2
# OR if the user has explicitly enabled zcopv2
IF((NOT DEFINED RTIME_INCLUDE_ZCOPY_V2 AND RTIME_PLATFORM_SUPPORTS_ZCOPY_V2) OR (RTIME_INCLUDE_ZCOPY_V2))
    LIST(APPEND RTIME_PLATFORM_PSL
        netiopsl::shmem/zcopy/posix
    )
ENDIF()

IF (NOT RTIME_CERT)
    LIST(APPEND RTIME_PLATFORM_PSL
        netiopsl::shmem/posix
        enable::RTIME_HAVE_POSIX_SHMEM
    )

    # TRUST-948 - QNX 7.0 has a bug in pthread_mutex
    if(NOT CMAKE_SYSTEM_VERSION VERSION_LESS 7.1)
        LIST(APPEND RTIME_PLATFORM_PSL
             enable::RTIME_HAVE_POSIX_ROBUST_MUTEX
        )
    else()
        LIST(APPEND RTIME_PLATFORM_PSL
             enable::RTIME_HAVE_POSIX_MUTEX
        )
    endif()
ENDIF()

# Flags below are only used by Zcopy V2
if(NOT CMAKE_SYSTEM_VERSION VERSION_LESS 7.1)
    ADD_DEFINITIONS(-DOSAPI_ROBUST_LOCKING_ENABLED=1)
else()
    ADD_DEFINITIONS(-DOSAPI_ROBUST_LOCKING_ENABLED=0)
endif()
