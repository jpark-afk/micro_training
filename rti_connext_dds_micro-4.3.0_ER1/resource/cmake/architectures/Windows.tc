# This architecture is expected to be compiled on a native machine with the
# default compiler
SET(CMAKE_SYSTEM_NAME Windows)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n Windows\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" The Windows target supports self-hosted builds on Windows")
    MESSAGE(" targets.")
    MESSAGE("\nARGUMENTS\n")
    MESSAGE(" If RTIME_TARGET_NAME includes either Win32 or Win64,")
    MESSAGE(" extra system libraries will be linked.")
    MESSAGE("\nEXAMPLES\n")
    MESSAGE(" --target Windows --name i86Win32VS2010\n")
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/windows.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/vscc.tc)

SET(RTIME_OSAPI_PLATFORM windows)
