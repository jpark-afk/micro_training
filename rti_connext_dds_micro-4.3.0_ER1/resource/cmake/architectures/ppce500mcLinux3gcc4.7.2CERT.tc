INCLUDE(CMakeForceCompiler)

SET(CMAKE_SYSTEM_NAME Linux)
SET(CMAKE_SYSTEM_PROCESSOR ppce500mc)

if (NOT DEFINED ENV{FREESCALE_ROOT})
    if (NOT DEFINED FREESCALE_ROOT)
        set(FREESCALE_ROOT "/local/applications/freescale/v1.4/x86_64/sysroots")
    endif()
else()
    set(FREESCALE_ROOT $ENV{FREESCALE_ROOT})
endif()

MESSAGE("FREESCALE_ROOT: ${FREESCALE_ROOT}")

SET(COMPILER_PATH "${FREESCALE_ROOT}/x86_64-fsl_networking_sdk-linux/usr/bin/ppce500mc-fsl_networking-linux")
SET(COMPILER_PREFIX "powerpc-fsl_networking-linux-")
SET(CMAKE_CXX_COMPILER "${COMPILER_PATH}/powerpc-fsl_networking-linux-g++")
SET(CMAKE_C_COMPILER   "${COMPILER_PATH}/powerpc-fsl_networking-linux-gcc")
SET(CMAKE_SYSROOT "${FREESCALE_ROOT}/ppce500mc-fsl_networking-linux")
SET(RTI_GCC_VERSION "4.7.2")
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)

SET(RTIME_OSAPI_PLATFORM posix)

SET(RTIME_CERT TRUE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

