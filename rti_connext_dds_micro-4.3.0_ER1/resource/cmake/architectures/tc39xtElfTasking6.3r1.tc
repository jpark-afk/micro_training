SET(CMAKE_SYSTEM_NAME RTIME_MICROSAR_PI)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n tc39xtElfTasking6.3r1 PIL\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" This PIL target can be used with AUTOSAR")
    MESSAGE(" targets. Before running this target make sure")
    MESSAGE(" you set up the TOOLCHAIN_PATH environment variable.")
    MESSAGE("\nAvailable PSLs for this PIL")
    MESSAGE(" --name tc39xtElfTasking6.3r1-MICROSAR4\n")
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/tasking_pi.tc)

FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

IF (${RTI_BUILD_UNITTESTS})
    ADD_DEFINITIONS(-D__autosar__)
    ADD_DEFINITIONS(-DRTI_32SYSTEM=1)
ENDIF()

SET(RTIME_EXCLUDE_NETIO_ZCOPY TRUE)
ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi_cc_tasking.h)


set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

INCLUDE_TASKING_COMPILER_PIL("6.3r1")