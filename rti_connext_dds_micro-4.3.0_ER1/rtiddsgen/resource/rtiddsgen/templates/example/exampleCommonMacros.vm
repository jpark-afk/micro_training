${envMap.POUND_CHAR}else
    dr_qos.resource_limits.max_instances = 2;
${envMap.POUND_CHAR}endif

#else
    dr_qos.resource_limits.max_instances = 1;
#end
    dr_qos.resource_limits.max_samples_per_instance = 32;
    dr_qos.resource_limits.max_samples = dr_qos.resource_limits.max_instances *
                                dr_qos.resource_limits.max_samples_per_instance;
    /* if there are more remote writers, you need to increase these limits */
    dr_qos.reader_resource_limits.max_remote_writers = 10;
    dr_qos.reader_resource_limits.max_remote_writers_per_instance = 10;
    dr_qos.history.depth = 32;

    /* Reliability QoS */
${envMap.POUND_CHAR}ifdef USE_RELIABLE_QOS
    dr_qos.reliability.kind = DDS_RELIABLE_RELIABILITY_QOS;
${envMap.POUND_CHAR}else
    dr_qos.reliability.kind = DDS_BEST_EFFORT_RELIABILITY_QOS;
${envMap.POUND_CHAR}endif

#if ($use_listener)
#if (!$use_content_filter)
${envMap.POUND_CHAR}ifdef USE_SAMPLE_FILTER
    /* choose one callback to enable */
${envMap.POUND_CHAR}ifdef FILTER_ON_DESERIALIZE
    dr_listener.on_before_sample_deserialize =
        ${constructMap.nativeFQName}Subscriber_on_before_sample_deserialize;
${envMap.POUND_CHAR}else
    dr_listener.on_before_sample_commit =
        ${constructMap.nativeFQName}Subscriber_on_before_sample_commit;
${envMap.POUND_CHAR}endif  /* FILTER_ON_DESERIALIZE */
${envMap.POUND_CHAR}endif  /* USE_SAMPLE_FILTER */

#end
    dr_listener.on_data_available = ${constructMap.nativeFQName}Subscriber_on_data_available;
    dr_listener.on_subscription_matched =
        ${constructMap.nativeFQName}Subscriber_on_subscription_matched;

    dr_listener.as_listener.listener_data = &total_samples;

#end
#if (!$use_dpde)
    dr_qos.protocol.rtps_object_id = 200;

#end

#if ($use_content_filter)
#if ($use_custom_content_filter)
#defineCustomContentFilter()
#else
#defineContentFilter()
#end
#end
#end  ## #macro(subscriberMainWArgsPreCreateDataReaderC)


#macro(subscriberMainWArgsCreateDataReaderC)
#if ($use_listener)
    datareader = DDS_Subscriber_create_datareader(
                     subscriber,
                     DDS_Topic_as_topicdescription(application->topic),
                     &dr_qos,
                     &dr_listener,
                     DDS_DATA_AVAILABLE_STATUS | DDS_SUBSCRIPTION_MATCHED_STATUS);
#else
    datareader = DDS_Subscriber_create_datareader(
                     subscriber,
                     DDS_Topic_as_topicdescription(application->topic),
                     &dr_qos,
                     NULL,
                     DDS_STATUS_MASK_NONE);
#end

    if (datareader == NULL)
    {
        printf("datareader == NULL\n");
        goto done;
    }

#if (!$use_listener)
    /* Initialize waitset related variables */
    if (!DDS_ConditionSeq_initialize(&active_conditions))
    {
        printf("cannot initialize active_conditions\n");
        goto done;
    }
    finalize_active_conditions = DDS_BOOLEAN_TRUE;
    if (!DDS_ConditionSeq_set_maximum(&active_conditions, 1))
    {
        printf("cannot set maximum of active_conditions\n");
        goto done;
    }

    waitset = DDS_WaitSet_new();
    if (waitset == NULL )
    {
        printf("waitset == NULL\n");
        goto done;
    }

    dr_condition = DDS_Entity_get_statuscondition(
                        DDS_DataReader_as_entity(datareader));

    retcode = DDS_StatusCondition_set_enabled_statuses(
                  dr_condition,
                  DDS_DATA_AVAILABLE_STATUS | DDS_SUBSCRIPTION_MATCHED_STATUS);

    if (retcode != DDS_RETCODE_OK)
    {
        printf("Cannot set status condition's enabled statuses\n");
        goto done;
    }

    retcode = DDS_WaitSet_attach_condition(
                waitset,
                DDS_StatusCondition_as_condition(dr_condition));
    if (retcode != DDS_RETCODE_OK)
    {
        printf("Cannot attach DR condition to waitset\n");
        goto done;
    }

#end
#end  ## #macro(subscriberMainWArgsCreateWaitsetC)


#macro(subscriberMainWArgsAssertRemotePublicationC)
    rem_publication_data.key.value[DDS_BUILTIN_TOPIC_KEY_OBJECT_ID] = 100;
    rem_publication_data.topic_name = DDS_String_dup(application->topic_name);
    rem_publication_data.type_name = DDS_String_dup(application->type_name);

${envMap.POUND_CHAR}ifdef USE_RELIABLE_QOS
    rem_publication_data.reliability.kind = DDS_RELIABLE_RELIABILITY_QOS;
${envMap.POUND_CHAR}else
    rem_publication_data.reliability.kind  = DDS_BEST_EFFORT_RELIABILITY_QOS;
${envMap.POUND_CHAR}endif

    retcode = DPSE_RemotePublication_assert(
       application->participant,
       "publisher",
       &rem_publication_data,
       ${constructMap.nativeFQNameInModule}I_get_key_kind());

    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to assert remote publication\n");
        goto done;
    }

#end  ## #macro(subscriberMainWArgsAssertRemotePublicationC)


#macro(subscriberMainWArgsApplicationEnableC)
#if (!${use_autoenable_entities})
    retcode = Application_enable(application);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to enable application\n");
        goto done;
    }

#end
#end  ## #macro(subscriberMainWArgsApplicationEnableC)


#macro(subscriberMainWArgsListenerWaitForSamplesC)
${envMap.POUND_CHAR}ifdef RTI_CERT
${envMap.POUND_CHAR}ifdef RTI_VXWORKS
    /** End initialization, disable further dynamic memory allocation ***/
    memAllocDisable();
${envMap.POUND_CHAR}endif
${envMap.POUND_CHAR}endif

    for (i = 0; (application->count <= 0) || (i < application->count); ++i)
    {
        printf("Subscriber sleeping for %d msec...\n", application->sleep_time);

        #functionPublisherSubscriberSleep()
    }

    ret_value = 0;

    done:

#end  ## #macro(subscriberMainWArgsListenerWaitForSamplesC)


#macro(subscriberMainWArgsWaitsetWaitForSamplesC)
    for (i = 0; (application->count <= 0) || (i < application->count); ++i)
    {
        ${constructMap.nativeFQName}Subscriber_wait_for_data(
            application,
            datareader,
            waitset,
            &active_conditions,
            &total_samples);

        printf(
            "Received %d out %d expected samples\n",
            total_samples,
            application->count);
    }

    ret_value = 0;

    done:

#end  ## #macro(subscriberMainWArgsListenerWaitForSamplesC)


#macro(subscriberMainWArgsDeleteWaitsetC)
    if (waitset != NULL)
    {
        retcode = DDS_WaitSet_detach_condition(
                    waitset, DDS_StatusCondition_as_condition(dr_condition));
        if (retcode != DDS_RETCODE_OK)
        {
            printf("Cannot detach condition from waitset\n");
            return -1;
        }
        else
        {
            retcode = DDS_WaitSet_delete(waitset);
            if (retcode != DDS_RETCODE_OK)
            {
                printf("Cannot delete waitset\n");
                return -1;
            }
        }

    }
    if (finalize_active_conditions)
    {
        if (!DDS_ConditionSeq_finalize(&active_conditions))
        {
            printf("Cannot finalize active_conditions sequence\n");
            return -1;
        }
    }

#end  ## #macro(subscriberMainWArgsDeleteWaitsetC)


#macro(subscriberMainWArgsDeleteApplicationC)
#subscriberMainWArgsDeleteApplicationOnlyC()
${envMap.POUND_CHAR}ifndef RTI_CERT
    retcode = DDS_DataReaderQos_finalize(&dr_qos);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("Cannot finalize DataReaderQos\n");
        return -1;
    }

#if (!$use_dpde)
    if (DDS_PublicationBuiltinTopicData_finalize(&rem_publication_data) !=
            DDS_BOOLEAN_TRUE)
    {
        printf("Cannot finalize DDS_PublicationBuiltinTopicData\n");
        return -1;
    }

#end
${envMap.POUND_CHAR}endif
#end  ## #macro(subscriberMainWArgsDeleteApplicationC)


#macro(subscriberMainWArgsReturnC)
    if (ret_value == 0)
    {
        printf("Samples received %d\n", total_samples);
        if (total_samples == 0)
        {
            return -1;
        }
    }

    return ret_value;
}
#end  ## #macro(subscriberMainWArgsReturnC)


#macro(subscriberMainWArgsDeleteApplicationOnlyC)
${envMap.POUND_CHAR}ifndef RTI_CERT
    if (application != NULL)
    {
        Application_delete(application);
    }

${envMap.POUND_CHAR}endif
#end


