    datareader = subscriber->create_datareader(
                     application->topic,
                     dr_qos,
                     NULL,
                     ${dds2_ns}STATUS_MASK_NONE);
#end

    if (datareader == NULL)
    {
        printf("datareader == NULL\n");
        goto done;
    }

#if (!$use_listener)
    /* Call to get_statuscondition() method to obtain a reference
     * to the datareader status_condition.
     */
    status_condition = datareader->get_statuscondition();
    if (!status_condition)
    {
        printf("Error getting status_condition from datareader.\n");
        goto done;
    }

    /* Using that reference, we can set the events we want to handle with
     * our waitset. In this example we handle on_data_available and
     * on_subscription_matched.
     */
    retcode = status_condition->set_enabled_statuses(
                  (${dds2_ns}StatusMask)${dds2_ns}DATA_AVAILABLE_STATUS | DDS_SUBSCRIPTION_MATCHED_STATUS);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("Error setting enabled statuses\n.");
        goto done;
    }

    /* Initialize waitset related variables */
    if (!active_conditions_seq.maximum(2))
    {
        printf("Error setting maximum of active_conditions\n");
        goto done;
    }

    /* Finally attach the previously configured status_condition
     * that will trigger the waitset activation */
    retcode = waitset.attach_condition(status_condition);
    if (retcode != ${dds2_ns}RETCODE_OK)
    {
        printf("Error attaching condition to waitset.\n");
        goto done;
    }

    hw_datareader = ${constructMap.nativeFQName}DataReader::narrow(datareader);
    if (hw_datareader == NULL)
    {
        printf("narrow error\n");
        goto done;
    }

    /* End of waitset configuration */

#end
#end  ## #macro(subscriberMainWArgsCreateDataReaderCPP)


#macro(subscriberMainWArgsAssertRemotePublicationsCPP)
    rem_publication_data.key.value[DDS_BUILTIN_TOPIC_KEY_OBJECT_ID] = 100;

    topic_name_len = strlen(application->topic_name);
