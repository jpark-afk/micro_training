#macro(declareFunctionMagPublisherMainWArgsC)
static int
publisher_main_w_args(DDS_Long sleep_time, DDS_Long count)
{
    DDS_DataWriter *datawriter;
    ${constructMap.nativeFQName}DataWriter *hw_datawriter;
    DDS_ReturnCode_t retcode;
    ${constructMap.nativeFQName} *sample = NULL;
    struct Application *application = NULL;
    DDS_Long i;
    struct DDS_DataWriterListener dw_listener =
        DDS_DataWriterListener_INITIALIZER;
    int ret_value = -1;

    ##
    ## When the type is not annotated with @transfer_mode (SHMEM_REF)
    ## proceed to create the sample using the type support
    ##
#if(!${constructMap.isMetpType})
    sample = ${constructMap.nativeFQName}TypeSupport_create_data();
    if (sample == NULL)
    {
        printf("failed ${constructMap.nativeFQName}TypeSupport_create_data\n");
        return -1;
    }
#end

    application = Application_create(PUB_PARTICIPANT_NAME, sleep_time, count);

    if (application == NULL)
    {
        printf("failed Application create\n");
        goto done;
    }

    datawriter = DDS_DomainParticipant_lookup_datawriter_by_name(
                     application->participant,
                     PUB_DATAWRITER_NAME);
    if (datawriter == NULL)
    {
        printf("datawriter == NULL\n");
        goto done;
    }

    dw_listener.on_publication_matched =
        ${constructMap.nativeFQName}Publisher_on_publication_matched;

    retcode = DDS_DataWriter_set_listener(
                  datawriter,
                  &dw_listener,
                  DDS_PUBLICATION_MATCHED_STATUS);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to set writer listener\n");
        goto done;
    }

#end  ## #macro(declareFunctionMagPublisherMainWArgsC)


##******************************************************************************
## Macros for the mag C subscriber file
##******************************************************************************


#macro(declareFunctionMagSubscriberMainWArgsC)
static int
subscriber_main_w_args(
    DDS_Long sleep_time,
    DDS_Long count)
{
    DDS_DataReader *datareader;
    DDS_ReturnCode_t retcode;
    struct Application *application;
    struct DDS_DataReaderListener dr_listener =
        DDS_DataReaderListener_INITIALIZER;
    int ret_value = -1;
    DDS_Long total_samples = 0;
    DDS_Long i;

    application = Application_create(SUB_PARTICIPANT_NAME, sleep_time, count);

    if (application == NULL)
    {
        printf("failed Application create\n");
        goto done;
    }

    datareader = DDS_DomainParticipant_lookup_datareader_by_name(
                     application->participant,
                     SUB_DATAREADER_NAME);
    if (datareader == NULL)
    {
        printf("datareader == NULL\n");
        goto done;
    }

#if ($use_listener && !$use_content_filter)
${envMap.POUND_CHAR}ifdef USE_SAMPLE_FILTER
    /* choose one callback to enable */
${envMap.POUND_CHAR}ifdef FILTER_ON_DESERIALIZE
    dr_listener.on_before_sample_deserialize =
        ${constructMap.nativeFQName}Subscriber_on_before_sample_deserialize;
${envMap.POUND_CHAR}else
    dr_listener.on_before_sample_commit =
        ${constructMap.nativeFQName}Subscriber_on_before_sample_commit;
${envMap.POUND_CHAR}endif  /* FILTER_ON_DESERIALIZE */
${envMap.POUND_CHAR}endif  /* USE_SAMPLE_FILTER */

#end
    dr_listener.on_data_available = ${constructMap.nativeFQName}Subscriber_on_data_available;
    dr_listener.on_subscription_matched =
        ${constructMap.nativeFQName}Subscriber_on_subscription_matched;

    dr_listener.as_listener.listener_data = &total_samples;

    retcode = DDS_DataReader_set_listener(
                  datareader,
                  &dr_listener,
                  DDS_DATA_AVAILABLE_STATUS | DDS_SUBSCRIPTION_MATCHED_STATUS);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to set reader listener\n");
        goto done;
    }

#if (!${use_autoenable_entities})
    retcode = Application_enable(application);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to enable application\n");
        goto done;
    }

#end
#end  ## #macro(declareFunctionMagSubscriberMainWArgsC)



