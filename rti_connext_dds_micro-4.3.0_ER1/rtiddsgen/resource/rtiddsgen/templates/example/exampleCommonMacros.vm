##---------------------------------------------------------------------
## Custom filter implementation for embedding in application.c.
## application.c already has the required headers via
## commonIncludesC and the Application.h header.
##---------------------------------------------------------------------
#macro(customFilterImplementationC)
#if ($filterFoundMember)

/*
 * ----------------------------------------------------------------
 * Custom Content Filter Implementation
 * ----------------------------------------------------------------
 */

struct ${constructMap.nativeFQName}CustomCompiledFilter
{
    DDS_Boolean in_use;
    DDS_LongLong divisor;
};

struct ${constructMap.nativeFQName}CustomFilter
{
    struct ${constructMap.nativeFQName}CustomFilterProperty property;
    struct ${constructMap.nativeFQName}CustomCompiledFilter *compiled_pool;
    RTI_UINT32 pool_size;
};

static void *
${constructMap.nativeFQName}CustomFilter_create_instance(
        const struct DDS_FilterResourceLimits *resource_limits,
        const void *property)
{
    struct ${constructMap.nativeFQName}CustomFilter *filter = NULL;

    if ((resource_limits == NULL) || (property == NULL))
    {
        printf("CustomFilter_create_instance: unexpected NULL argument\n");
        return NULL;
    }

    OSAPI_Heap_allocate_struct(
            &filter,
            struct ${constructMap.nativeFQName}CustomFilter);
    if (filter == NULL)
    {
        printf("CustomFilter_create_instance: failed to allocate filter\n");
        return NULL;
    }

    filter->property =
            *(const struct ${constructMap.nativeFQName}CustomFilterProperty *)property;
    filter->pool_size = (RTI_UINT32)resource_limits->filter_expression_max_count;

    OSAPI_Heap_allocate_array(
            &filter->compiled_pool,
            filter->pool_size,
            struct ${constructMap.nativeFQName}CustomCompiledFilter);
    if (filter->compiled_pool == NULL)
    {
        printf("CustomFilter_create_instance: failed to allocate compiled pool\n");
        OSAPI_Heap_free_struct(filter);
        return NULL;
    }

    OSAPI_Memory_zero(
            filter->compiled_pool,
            filter->pool_size
                    * sizeof(struct ${constructMap.nativeFQName}CustomCompiledFilter));

    return filter;
}

${envMap.POUND_CHAR}ifndef RTI_CERT
static void
${constructMap.nativeFQName}CustomFilter_delete_instance(
        void *filter_instance)
{
    struct ${constructMap.nativeFQName}CustomFilter *filter =
            (struct ${constructMap.nativeFQName}CustomFilter *)filter_instance;

    if (filter_instance == NULL)
    {
        printf("CustomFilter_delete_instance: unexpected NULL filter_instance\n");
        return;
    }

    OSAPI_Heap_free_array(filter->compiled_pool);
    OSAPI_Heap_free_struct(filter);
}
${envMap.POUND_CHAR}endif /* !RTI_CERT */

static DDS_Boolean
${constructMap.nativeFQName}CustomFilter_compile(
        void *filter_instance,
        void **compiled_expression_out,
        const char *expression,
        const struct DDS_StringSeq *parameters,
        const struct DDS_TypeCode *type_code,
        const char *type_class_name)
{
    struct ${constructMap.nativeFQName}CustomFilter *filter =
            (struct ${constructMap.nativeFQName}CustomFilter *)filter_instance;
    struct ${constructMap.nativeFQName}CustomCompiledFilter *compiled = NULL;
    const char *param_str = NULL;
    RTI_UINT32 i = 0;

    UNUSED_ARG(type_code);

    if ((filter_instance == NULL)
        || (compiled_expression_out == NULL)
        || (expression == NULL)
        || (parameters == NULL)
        || (type_class_name == NULL))
    {
        printf("CustomFilter_compile: unexpected NULL argument\n");
        return DDS_BOOLEAN_FALSE;
    }

    /* Validate type class name */
    if (OSAPI_String_cmp(type_class_name, "${constructMap.FQName}") != 0)
    {
        printf("CustomFilter_compile: unsupported type: %s\n", type_class_name);
        return DDS_BOOLEAN_FALSE;
    }

    /* Validate expression matches expected pattern.
     * This example only supports a single fixed expression for simplicity.
     */
    if (OSAPI_String_cmp(expression, ${filterTypeNameUpper}_CUSTOM_FILTER_EXPRESSION) != 0)
    {
        printf("CustomFilter_compile: unsupported expression: %s\n", expression);
        return DDS_BOOLEAN_FALSE;
    }

    /* Need exactly 1 parameter ($0 = divisor) */
    if (DDS_StringSeq_get_length(parameters) < 1)
    {
        printf("CustomFilter_compile: expected 1 parameter, got %d\n",
                DDS_StringSeq_get_length(parameters));
        return DDS_BOOLEAN_FALSE;
    }

    param_str = *DDS_StringSeq_get_reference(parameters, 0);
    if (param_str == NULL)
    {
        printf("CustomFilter_compile: parameter 0 is NULL\n");
        return DDS_BOOLEAN_FALSE;
    }

    /* Find an unused entry in the preallocated pool */
    for (i = 0; i < filter->pool_size; i++)
    {
        if (!filter->compiled_pool[i].in_use)
        {
            compiled = &filter->compiled_pool[i];
            break;
        }
    }

    if (compiled == NULL)
    {
        printf("CustomFilter_compile: compiled filter pool exhausted\n");
        return DDS_BOOLEAN_FALSE;
    }

    compiled->in_use = DDS_BOOLEAN_TRUE;
    compiled->divisor = (DDS_LongLong)atol(param_str);
    if (compiled->divisor == 0)
    {
        printf("CustomFilter_compile: divisor must not be 0\n");
        compiled->in_use = DDS_BOOLEAN_FALSE;
        return DDS_BOOLEAN_FALSE;
    }
    *compiled_expression_out = compiled;

    return DDS_BOOLEAN_TRUE;
}

static DDS_Boolean
${constructMap.nativeFQName}CustomFilter_evaluate(
        void *filter_instance,
        void *compiled_expression,
        const void *sample,
        DDS_Boolean *result_out)
{
    struct ${constructMap.nativeFQName}CustomCompiledFilter *compiled =
            (struct ${constructMap.nativeFQName}CustomCompiledFilter *)compiled_expression;
    const struct ${constructMap.nativeFQName} *typed_sample =
            (const struct ${constructMap.nativeFQName} *)sample;

    if ((filter_instance == NULL)
        || (compiled_expression == NULL)
        || (sample == NULL)
        || (result_out == NULL))
    {
        printf("CustomFilter_evaluate: unexpected NULL argument\n");
        return DDS_BOOLEAN_FALSE;
    }

    UNUSED_ARG(filter_instance);

    *result_out =
            (((DDS_LongLong)typed_sample->${filterMember} % compiled->divisor) == 0)
            ? DDS_BOOLEAN_TRUE : DDS_BOOLEAN_FALSE;

    return DDS_BOOLEAN_TRUE;
}

static void
${constructMap.nativeFQName}CustomFilter_finalize(
        void *filter_instance,
        void *compiled_expression)
{
    struct ${constructMap.nativeFQName}CustomCompiledFilter *compiled =
            (struct ${constructMap.nativeFQName}CustomCompiledFilter *)compiled_expression;

    UNUSED_ARG(filter_instance);

    if (compiled_expression == NULL)
    {
        printf("CustomFilter_finalize: unexpected NULL compiled_expression\n");
        return;
    }

    compiled->in_use = DDS_BOOLEAN_FALSE;
}

static const struct DDS_ContentFilterI
${constructMap.nativeFQName}CustomFilter_fv_interface =
{
    ${constructMap.nativeFQName}CustomFilter_create_instance,
${envMap.POUND_CHAR}ifndef RTI_CERT
