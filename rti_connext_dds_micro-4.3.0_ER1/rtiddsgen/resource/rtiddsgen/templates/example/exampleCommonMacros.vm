#macro(functionApplicationDeleteC)
${envMap.POUND_CHAR}ifndef RTI_CERT
void
Application_delete(struct Application *application)
{
    DDS_ReturnCode_t retcode;
    RT_Registry_T *registry = NULL;
    DDS_DomainParticipantFactory *factory = NULL;
#if (${use_udp})
    struct UDP_InterfaceFactoryProperty *udp_property = NULL;
#end
#if ($use_psk)
    struct DDS_PskServiceFactoryProperty psk_svc_property =
    DDS_PskServiceFactoryProperty_INITIALIZER;
#end
    if (application == NULL)
    {
        return;
    }

    factory = DDS_DomainParticipantFactory_get_instance();

    if (application->participant != NULL)
    {
        retcode = DDS_DomainParticipant_delete_contained_entities(
                      application->participant);
        if (retcode != DDS_RETCODE_OK)
        {
            printf("failed to delete contained entities (retcode=%d)\n",retcode);
        }

        retcode = DDS_DomainParticipantFactory_delete_participant(
                      factory,
                      application->participant);
        if (retcode != DDS_RETCODE_OK)
        {
            printf("failed to delete participant: %d\n", retcode);
            return;
        }
    }

    registry = DDS_DomainParticipantFactory_get_registry(factory);

#if (${use_secure})
${envMap.POUND_CHAR}ifdef USE_SECURITY
    if (!Application_finalize_security(application, registry))
    {
        printf("failed to finalize security\n");
        return;
    }
${envMap.POUND_CHAR}endif

#end
#if(${constructMap.isMetpType} || ${use_shared_memory})
#if(!$use_zcv2)
    if (!RT_Registry_unregister(registry, NETIO_DEFAULT_SHMEM_NAME, NULL, NULL))
    {
        printf("failed to unregister shmem\n");
        return;
    }
#end
#end
#if (${use_udp})
    if (!RT_Registry_unregister(
             registry,
             NETIO_DEFAULT_UDP_NAME,
             (struct RT_ComponentFactoryProperty**)&udp_property,
             NULL))
    {
       printf("failed to unregister udp\n");
       return;
    }
    if (udp_property != NULL)
    {
        UDP_InterfaceFactoryProperty_finalize(udp_property);
        free(udp_property);
        udp_property = NULL;
    }

#end

#if ($use_zcv2)

    if (!ZCOPY_NotifMechanism_unregister(registry,NETIO_DEFAULT_NOTIF_NAME))
    {
        printf("failed to unregister the Notification Interface \n");
        return;
    }

    if (!NDDS_Transport_ZeroCopy_finalize(registry,NULL))
    {
        printf("failed to finalize the Notification Interface \n");
        return;
    }
#end
#if ($use_content_filter)

    if (DDS_FilterPluginFactory_unregister() != DDS_RETCODE_OK)
    {
        printf("failed to unregister filter plugin factory\n");
        return;
    }
#end

    if (!RT_Registry_unregister(registry, "$discovery_plugin_name", NULL, NULL))
    {
        printf("failed to unregister $discovery_plugin_name\n");
        return;
    }
    if (!RT_Registry_unregister(
             registry,
             DDSHST_READER_DEFAULT_HISTORY_NAME,
             NULL,
             NULL))
    {
        printf("failed to unregister rh\n");
        return;
    }

#if (!$use_zcv2)
    if (!RT_Registry_unregister(
             registry,
             DDSHST_WRITER_DEFAULT_HISTORY_NAME,
             NULL,
             NULL))
    {
        printf("failed to unregister wh\n");
        return;
    }
#end
#if ($use_psk)
#finalizePsk()

#end
    free(application);

    retcode = DDS_DomainParticipantFactory_finalize_instance();
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to finalize instance %d\n", retcode);
        return;
    }
}

${envMap.POUND_CHAR}endif /* !RTI_CERT */
#end  ## #macro(functionApplicationDeleteC)


