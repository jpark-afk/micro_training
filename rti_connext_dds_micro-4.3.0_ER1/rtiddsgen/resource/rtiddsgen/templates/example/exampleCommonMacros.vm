#macro(functionApplicationHelpCPP)
void
Application::help(char *appname)
{
    printf("%s [options]\n", appname);
    printf("options:\n");
    printf("-h                      - This text\n");
#if (!$use_mag)
    printf("-domain <id>            - DomainId (default: 0)\n");
    printf("-udp_intf <intf>        - udp interface (no default)\n");
    printf("-peer <address>         - peer address (no default)\n");
#end
    printf("-count <count>          - count (default -1)\n");
    printf("-sleep <ms>             - sleep between sends (default 1s)\n");
#if (${use_secure})
    printf("-ca-id <ca.pem>         - %s (default: %s)\n",
        "URL of Identity Certificate Authority's certificate",
        PEER_MATERIAL_DEFAULT.ca_id_cert);
    printf("-ca-perm <ca.pem>       - %s (default: %s)\n",
        "URL of Permissions Certificate Authority's certificate",
        PEER_MATERIAL_DEFAULT.ca_perm_cert);
    printf("-key <peer_key.pem>     - %s (default: %s)\n",
        "URL of DomainParticipants's private key",
        PEER_MATERIAL_DEFAULT.peer_key);
    printf("-cert <peer.pem>        - %s (default: %s)\n",
        "URL of DomainParticipants's certificate",
        PEER_MATERIAL_DEFAULT.peer_cert);
    printf("-gov <governance.p7s>   - %s (default: %s)\n",
        "URL of signed XML governance file",
        PEER_MATERIAL_DEFAULT.xml_gov);
    printf("-perm <permissions.p7s> - %s (default: %s)\n",
        "URL of signed XML permissions file",
        PEER_MATERIAL_DEFAULT.xml_perm);
#end
    printf("\n");
}
#end  ## #macro(functionApplicationHelpCPP)

#macro(functionApplicationInitializeDeclareCPP)
${dds2_ns}ReturnCode_t
Application::initialize(
    const char *local_participant_name,
    const char *remote_participant_name,
    ${dds2_ns}Long domain_id,
    char *udp_intf,
    char *peer,
    ${dds2_ns}Long sleep_time_arg,
#if (${use_secure})
    ${dds2_ns}Long count_arg,
    ApplicationSecMaterial *sec_material)
#else
    ${dds2_ns}Long count_arg)
#end
{
    ${dds2_ns}ReturnCode_t retcode;
#if (!${use_autoenable_entities})
    ${dds2_ns}DomainParticipantFactoryQos dpf_qos;
#end
    ${dds2_ns}DomainParticipantQos dp_qos;
#if($use_dpde)
    ${dpde2_ns}DiscoveryPluginProperty dpde_properties;
#else
    ${dpse2_ns}DiscoveryPluginProperty dpse_properties;
#end
    ${dds2_ns}Boolean success = ${dds2_ns}BOOLEAN_FALSE;
    ${rt_ns}Registry *registry = NULL;
    ${udp2_ns}InterfaceFactoryProperty *udp_property = NULL;
#if(${constructMap.isMetpType} && !$use_zcv2)
    ${netioshmem_ns}InterfaceFactoryProperty shmem_property;
#end
#if($use_dpde)

    (void)local_participant_name;
    (void)remote_participant_name;
#end

    /* Uncomment to increase verbosity level:
       OSAPI_Log_set_verbosity(OSAPI_LOG_VERBOSITY_WARNING);
    */

    this->sleep_time = sleep_time_arg;
    this->count = count_arg;

    registry = ${dpf_name}->get_registry();

    if (!registry->register_component(
             "wh",
             ${wh_ns}HistoryFactory::get_interface(),
             NULL,
             NULL))
    {
        printf("failed to register wh\n");
        goto done;
    }

    if (!registry->register_component(
             "rh",
             ${rh_ns}HistoryFactory::get_interface(),
             NULL,
             NULL))
    {
        printf("failed to register rh\n");
        goto done;
    }

    /* If the UDP transport has already been registered, unregister it to
     * set new properties.
     */
    if (registry->unregister(${netio_ns}DEFAULT_UDP_NAME, NULL, NULL))
    {
        printf("Unregistered existing UDP transport.\n");
    }

    udp_property = new ${udp2_ns}InterfaceFactoryProperty();
    if (udp_property == NULL)
    {
        printf("failed to allocate udp properties\n");
        goto done;
    }

    /* For additional allowed interface(s), increase maximum and length, and
       set interface below:
    */
    if (!udp_property->allow_interface.maximum(2))
    {
        printf("failed to set allow_interface maximum\n");
        goto done;
    }
    if (!udp_property->allow_interface.length(2))
    {
        printf("failed to set allow_interface length\n");
        goto done;
    }

    /* loopback interface */
${envMap.POUND_CHAR}if defined(RTI_DARWIN) || defined(RTI_VXWORKS) || defined(RTI_QNX)
    udp_property->allow_interface[0] = ${dds2_ns}String_dup("lo0");
${envMap.POUND_CHAR}elif defined (RTI_LINUX)
    udp_property->allow_interface[0] = ${dds2_ns}String_dup("lo");
${envMap.POUND_CHAR}elif defined(RTI_WIN32)
    udp_property->allow_interface[0] =
        DDS_String_dup("Loopback Pseudo-Interface 1");
${envMap.POUND_CHAR}else
    udp_property->allow_interface[0] = ${dds2_ns}String_dup("lo");
${envMap.POUND_CHAR}endif

    if (udp_intf != NULL)
    { /* use interface supplied on command line */
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup(udp_intf);
    }
    else
    {                /* use hardcoded interface */
${envMap.POUND_CHAR}if defined(RTI_DARWIN)
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup("en1");
${envMap.POUND_CHAR}elif defined (RTI_LINUX)
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup("eth0");
${envMap.POUND_CHAR}elif defined (RTI_VXWORKS)
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup("motetsec0");
${envMap.POUND_CHAR}elif defined(RTI_WIN32)
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup("Local Area Connection");
${envMap.POUND_CHAR}else
        udp_property->allow_interface[1] =
            ${dds2_ns}String_dup("ce0");
${envMap.POUND_CHAR}endif
    }

    if (!registry->register_component(
             ${netio_ns}DEFAULT_UDP_NAME,
             ${udp_ns}InterfaceFactory::get_interface(),
             &udp_property->_parent._parent,
             NULL))
    {
        printf("failed to register udp\n");
        goto done;
    }

#if (!${use_autoenable_entities})
    ${dpf_name}->get_qos(dpf_qos);
    dpf_qos.entity_factory.autoenable_created_entities = ${dds2_ns}BOOLEAN_FALSE;
    ${dpf_name}->set_qos(dpf_qos);

#end
    if (peer == NULL)
    {
        peer = (char *)"_udp://127.0.0.1"; /* default to loopback */
    }

#if($use_dpde)
#if ($use_secure)
    /* In order to speed up mutual detection between participants and trigger
     * the authentication handshake, we reduce the liveliness assertion period
     * in the discovery plugin properties */
    dpde_properties.participant_liveliness_assert_period.sec = 5;

#end
    if (!registry->register_component(
                              "dpde",
                              ${dpde_ns}DiscoveryFactory::get_interface(),
                              &dpde_properties._parent,
                              NULL))
    {
        printf("failed to register dpde\n");
        goto done;
    }
#else
#if ($use_secure)
    /* In order to speed up mutual detection between participants and trigger
     * the authentication handshake, we reduce the liveliness assertion period
     * in the discovery plugin properties */
    dpde_properties.participant_liveliness_assert_period.sec = 5;

#end
    if (!registry->register_component(
                              "dpse",
                              ${dpse_ns}DiscoveryFactory::get_interface(),
                              &dpse_properties._parent,
                              NULL))
    {
        printf("failed to register dpse\n");
        goto done;
    }
#end

    if (!dp_qos.discovery.discovery.name.set_name("$discovery_plugin_name"))
    {
        printf("failed to set discovery plugin name\n");
        goto done;
    }

#if(${constructMap.isMetpType} && !$use_zcv2)
    if (!registry->register_component(
            NETIO_DEFAULT_SHMEM_NAME,
            ${shmem_ns}InterfaceFactory::get_interface(),
            &shmem_property._parent._parent,
            NULL))
    {
    	printf("failed to register shared memory interface factory\n");
        goto done;
    }

    dp_qos.transports.enabled_transports.maximum(2);
    dp_qos.transports.enabled_transports.length(2);
    dp_qos.transports.enabled_transports[0] = ${dds2_ns}String_dup("_shmem");
    dp_qos.transports.enabled_transports[1] = ${dds2_ns}String_dup("_udp");

    dp_qos.discovery.enabled_transports.maximum(2);
    dp_qos.discovery.enabled_transports.length(2);
    dp_qos.discovery.enabled_transports[0] = ${dds2_ns}String_dup("_shmem://");
    dp_qos.discovery.enabled_transports[1] = ${dds2_ns}String_dup("_udp://");

    dp_qos.user_traffic.enabled_transports.maximum(2);
    dp_qos.user_traffic.enabled_transports.length(2);
    dp_qos.user_traffic.enabled_transports[0] = ${dds2_ns}String_dup("_shmem://");
    dp_qos.user_traffic.enabled_transports[1] = ${dds2_ns}String_dup("_udp://");

    dp_qos.discovery.initial_peers.maximum(2);
    dp_qos.discovery.initial_peers.length(2);
    dp_qos.discovery.initial_peers[0] = ${dds2_ns}String_dup("_shmem://");
    dp_qos.discovery.initial_peers[1] = ${dds2_ns}String_dup(peer);
#else
    if (!dp_qos.transports.enabled_transports.maximum(1))
    {
        printf("failed to set maximum for transports.enabled_transports\n");
        goto done;
    }

    if (!dp_qos.transports.enabled_transports.length(1))
    {
        printf("failed to set length for transports.enabled_transports\n");
        goto done;
    }
    dp_qos.transports.enabled_transports[0] = ${dds2_ns}String_dup("_udp");

    if (!dp_qos.discovery.enabled_transports.maximum(3))
    {
        printf("failed to set maximum for discovery.enabled_transports\n");
        goto done;
    }

    if (!dp_qos.discovery.enabled_transports.length(3))
    {
        printf("failed to set length for discovery.enabled_transports\n");
        goto done;
    }

    dp_qos.discovery.enabled_transports[0] =
                                     ${dds2_ns}String_dup("_udp://239.255.0.1");

    dp_qos.discovery.enabled_transports[1] =
                                     ${dds2_ns}String_dup("_udp://");

    dp_qos.discovery.enabled_transports[2] =
                                     ${dds2_ns}String_dup("_udp://127.0.0.1");

    if (!dp_qos.user_traffic.enabled_transports.maximum(2))
    {
        printf("failed to set maximum for user_traffic.enabled_transports\n");
        goto done;
    }

    if (!dp_qos.user_traffic.enabled_transports.length(2))
    {
        printf("failed to set length for user_traffic.enabled_transports\n");
        goto done;
    }

    dp_qos.user_traffic.enabled_transports[0] =
                        ${dds2_ns}String_dup("_udp://");
    dp_qos.user_traffic.enabled_transports[1] =
                        ${dds2_ns}String_dup("_udp://127.0.0.1");

    dp_qos.discovery.initial_peers.maximum(1);
    dp_qos.discovery.initial_peers.length(1);
    dp_qos.discovery.initial_peers[0] = ${dds2_ns}String_dup(peer);
#end

    /* if there are more remote or local endpoints, you need to increase these limits */
    dp_qos.resource_limits.max_destination_ports = 32;
    dp_qos.resource_limits.max_receive_ports = 32;
    dp_qos.resource_limits.local_topic_allocation = 1;
    dp_qos.resource_limits.local_type_allocation = 1;
    dp_qos.resource_limits.local_reader_allocation = 1;
    dp_qos.resource_limits.local_writer_allocation = 1;
    dp_qos.resource_limits.remote_participant_allocation = 8;
    dp_qos.resource_limits.remote_reader_allocation = 8;
    dp_qos.resource_limits.remote_writer_allocation = 8;

#if(!$use_dpde)
    /* Must set the name of the domain participant in QoS for discovery */
    strncpy(dp_qos.participant_name.name,
            local_participant_name,
            sizeof(dp_qos.participant_name.name) - 1);
    dp_qos.participant_name.name[sizeof(dp_qos.participant_name.name) - 1] = '\0';
#end

#configureContentFilterResourceLimits()

#if (${use_secure})
#ifdef USE_SECURITY
    if (${dds2_ns}RETCODE_OK !=
            this->configure_security(registry, dp_qos, sec_material))
    {
        printf("failed to configure security\n");
        goto done;
    }
#endif /* USE_SECURITY */

#end
    this->participant = ${dpf_name}->create_participant(
                                    (${dds2_ns}DomainId_t)domain_id,
                                    dp_qos,
                                    NULL,
                                    ${dds2_ns}STATUS_MASK_NONE);

    if (this->participant == NULL)
    {
        printf("failed to create participant\n");
        goto done;
    }

    strncpy(this->type_name,
            ${constructMap.nativeFQName}TypeSupport::get_type_name(),
            sizeof(this->type_name) - 1);
    this->type_name[sizeof(this->type_name) - 1] = '\0';
    retcode = ${constructMap.nativeFQName}TypeSupport::register_type(
                  this->participant,
                  this->type_name);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to register type: %s\n", this->type_name);
        goto done;
    }

    strncpy(this->topic_name,
            "Example ${constructMap.nativeFQName}",
            sizeof(this->topic_name) - 1);
    this->topic_name[sizeof(this->topic_name) - 1] = '\0';
    this->topic = this->participant->create_topic(
                      this->topic_name,
                      this->type_name,
                      ${dds2_ns}TOPIC_QOS_DEFAULT,
                      NULL,
                      ${dds2_ns}STATUS_MASK_NONE);
    if (this->topic == NULL)
    {
        printf("topic == NULL\n");
        goto done;
    }

#if(!$use_dpde)
    retcode = ${dpse_ns}DiscoveryPlugin::RemoteParticipant_assert(
                  this->participant,
                  remote_participant_name);
    if (retcode != ${dds2_ns}RETCODE_OK)
    {
        printf("failed to assert remote participant\n");
        goto done;
    }
#end

    success = ${dds2_ns}BOOLEAN_TRUE;

  done:

    if (!success)
    {
        if (udp_property != NULL)
        {
            delete udp_property;
            udp_property = NULL;
        }
    }

    return (success ? ${dds2_ns}RETCODE_OK : ${dds2_ns}RETCODE_ERROR);
}
#end  ## #macro(functionApplicationInitializeDeclareCPP)


