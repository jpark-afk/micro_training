static int
err_listener(
    const char *msg,
    size_t msg_len,
    void *user_ptr)
{
    (void)msg_len;
    unsigned int *failed_count_ptr = (unsigned int *)user_ptr;

    if (failed_count_ptr != 0)
    {
        unsigned int failed_count = *failed_count_ptr;
        failed_count++;
        *failed_count_ptr = failed_count;
    }

    printf("Error message from the PSK PSL:\n%s\n\n", msg);

    return 1;
}
#end

#macro(varPsk)
    struct DDS_PskServiceFactoryProperty psk_svc_property =
        DDS_PskServiceFactoryProperty_INITIALIZER;
    struct DDS_SecTransform_Configuration psl_config = {0};
    static unsigned int failed_count = 0;
#end

#macro(setupPsk)
    psl_config.err_listener.callback = err_listener;
    psl_config.err_listener.user_ptr = &failed_count;
    psk_svc_property.psl_get_interface_func = PSK_OSSL_get_interface;
    psk_svc_property.psl_config = &psl_config;

    if(!DDS_PskLibrary_register(
            registry,
            &psk_svc_property))
    {
        printf("failed to register psk library \n");
        goto done;
    }

    if (!RT_ComponentFactoryId_set_name(&dp_qos.trust.suite, DDS_PSK_DEFAULT_SUITE_NAME))
    {
        printf("failed to set PSK plugin name\n");
        goto done;
    }

    for (DDS_UnsignedLong i = 0; i < sizeof(psk_dp_property_qos) / sizeof(PropertyValue_T); ++i)
    {
        if (DDS_PropertyQosPolicyHelper_add_property(
                &dp_qos.property,
                psk_dp_property_qos[i].name,
                psk_dp_property_qos[i].value,
                DDS_BOOLEAN_FALSE) != DDS_RETCODE_OK)
        {
            printf("failed to set %s property\n", psk_dp_property_qos[i].name);
            goto done;
        }
    }
#end
#macro(finalizePsk)
    if(!DDS_PskLibrary_unregister(
        registry,
        psk_svc_property.service_name))
    {
        printf("failed to unregister psk library \n");
        return;
    }
#end
