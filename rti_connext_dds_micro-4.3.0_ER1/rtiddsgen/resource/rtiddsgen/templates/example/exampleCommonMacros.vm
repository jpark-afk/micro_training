#macro(functionPublisherSubscriberSleep)
#if($use_cert_api_only)
/* OSAPI_Thread_sleep() is not included in Connext DDS Cert because it might not
 * be thread safe. For this reason a call to OSAPI_Thread_sleep() cannot be done
 * in this example. Instead we use the code below.
 */
${envMap.POUND_CHAR}if OSAPI_INCLUDE_POSIX
{
    struct timespec remain, next;
    int rval;
    time_t is;

    is = (time_t)(application->sleep_time / 1000);

    next.tv_sec = is;
    next.tv_nsec = ((application->sleep_time - ((DDS_Long)is * 1000)) * 1000000);

    do
    {
        rval = nanosleep(&next, &remain);
        if ((rval == -1) && (errno == EINTR))
        {
            next = remain;
        }
    } while ((rval == -1) && (errno == EINTR));
}
${envMap.POUND_CHAR}elif RTI_VXWORKS
    taskDelay(((sysClkRateGet() * application->sleep_time) + 500) / 1000);
${envMap.POUND_CHAR}elif RTI_WIN32
    Sleep((DWORD)application->sleep_time);
${envMap.POUND_CHAR}else
    ${envMap.POUND_CHAR}error "Implementation of sleep() needed"
${envMap.POUND_CHAR}endif
#else
OSAPI_Thread_sleep((RTI_UINT32)application->sleep_time);
#end
#end  ##  #macro(functionPublisherSubscriberCallMainWArgs $is_publisher)


