template <typename T>
void take_and_print(typename T::DataReader* reader, ${dds2_ns}Long *total_samples)
{
    ${constructMap.nativeFQName}Seq data_seq;
    ${dds2_ns}SampleInfoSeq info_seq;
    ${dds2_ns}ReturnCode_t retcode;
    int i;

    retcode = reader->take(
            data_seq,
            info_seq,
            ${dds2_ns}LENGTH_UNLIMITED,
            ${dds2_ns}ANY_SAMPLE_STATE,
            ${dds2_ns}ANY_VIEW_STATE,
            ${dds2_ns}ANY_INSTANCE_STATE);

    if (retcode != ${dds2_ns}RETCODE_OK)
    {
        printf("failed to take data, retcode(%d)\n", retcode);
        goto done;
    }

    for (i = 0; i < data_seq.length(); ++i)
    {
        if (!info_seq[i].valid_data)
        {
            printf("Got metadata. Instance State: %d.\n",
                    info_seq[i].instance_state);
        }
        else
        {
            #if ($constructMap.languageBinding.equals("FLAT_DATA"))
            // To access the data members, get the root to the flat-data sample:
            // ${constructMap.nativeFQName}Offset sample_root = sample_seq[i]->root();
            // use flat-data APIs to access individual members
            (*total_samples)++;
            #elseif(${constructMap.isMetpType})
            ${dds2_ns}Boolean is_data_consistent = ${dds2_ns}BOOLEAN_FALSE;
            ${constructMap.nativeFQName} *sample = NULL;

            sample = &data_seq[i];

            retcode = reader->is_data_consistent(
                          is_data_consistent,
                          *sample,
                          info_seq[i]);
            if (retcode == ${dds2_ns}RETCODE_OK)
            {
                if (is_data_consistent)
                {
                    printf("Sample is consistent\n");
                    printf("Processing is valid\n");
                    (*total_samples)++;
                }
                else
                {
                    printf("Sample is NOT consistent\n");
                }
            }
            #else
            ${constructMap.nativeFQName} *sample;

            sample = &data_seq[i];
            printf("Data received.\n");
            (*total_samples)++;

            /* TODO read and process sample attributes here */
            (void)sample;
            #end
            }
    }

    /* Return the loaned data */
    reader->return_loan(data_seq, info_seq);

done:
#if ($constructMap.languageBinding.equals("FLAT_DATA"))
    return;
#else
    ${constructMap.nativeFQName}Seq_finalize(&data_seq);
#end
}

void
${nativeFQName}ReaderListener::on_data_available(${dds_ns}DataReader *reader)
{
    ${constructMap.nativeFQName}DataReader *hw_reader = ${constructMap.nativeFQName}DataReader::narrow(reader);
    take_and_print< ${constructMap.nativeFQName}>(hw_reader, &total_samples);
}
