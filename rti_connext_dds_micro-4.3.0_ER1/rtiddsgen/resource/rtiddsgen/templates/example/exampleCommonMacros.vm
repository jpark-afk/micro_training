#macro(functionApplicationDeleteCPP)
Application::~Application()
{
    ${dds2_ns}ReturnCode_t retcode;
    ${rt_ns}Registry *registry = NULL;
    ${udp2_ns}InterfaceFactoryProperty *udp_property = NULL;

    if (this->participant != NULL)
    {
        retcode = this->participant->delete_contained_entities();
        if (retcode != DDS_RETCODE_OK)
        {
            printf("failed to delete contained entities (retcode=%d)\n",retcode);
        }

        retcode = ${dpf_name}->delete_participant(this->participant);
        if (retcode != ${dds2_ns}RETCODE_OK)
        {
            printf("failed to delete participant: %d\n", retcode);
            return;
        }
        this->participant = NULL;
    }

    registry = ${dpf_name}->get_registry();

#if(${constructMap.isMetpType} && !$use_zcv2)
    if (!registry->unregister(NETIO_DEFAULT_SHMEM_NAME, NULL, NULL))
    {
        printf("failed to unregister shmem\n");
        return;
    }
#end

    if (!registry->unregister(
             ${netio_ns}DEFAULT_UDP_NAME,
             (RT_ComponentFactoryProperty**)&udp_property,
             NULL))
    {
       printf("failed to unregister udp\n");
       return;
    }
    if (udp_property != NULL)
    {
        delete udp_property;
        udp_property = NULL;
    }

#if (${use_secure})
    if (!SECCORE_SecurePluginFactory::unregister_suite(registry, NULL))
    {
        printf("failed to unregister security plugins\n");
        return;
    }

#end
    if (!registry->unregister("${discovery_plugin_name}", NULL, NULL))
    {
        printf("failed to unregister ${discovery_plugin_name}\n");
        return;
    }

    if (!registry->unregister("rh", NULL, NULL))
    {
        printf("failed to unregister rh\n");
        return;
    }

    if (!registry->unregister("wh", NULL, NULL))
    {
        printf("failed to unregister wh\n");
        return;
    }

    retcode = ${dpf_name}->finalize_instance();
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to finalize instance (retcode=%d)\n",retcode);
        return;
    }
}
#end  ## #macro(functionApplicationDeleteCPP)


