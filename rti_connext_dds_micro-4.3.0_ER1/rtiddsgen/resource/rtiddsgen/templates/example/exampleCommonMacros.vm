#macro(subscriberMainWArgsListenerWaitForSamplesCPP)
    for (int i = 0; (application->count <= 0) || (i < application->count); ++i)
    {
        printf("Subscriber sleeping for %d msec...\n", application->sleep_time);

        #functionPublisherSubscriberSleep()
    }

    ret_value = 0;

    done:

#end  ## #macro(subscriberMainWArgsListenerWaitForSamplesCPP)


#macro(subscriberMainWArgsWaitsetWaitForSamplesCPP)
    wait_timeout.sec = application->sleep_time / 1000;
    wait_timeout.nanosec = (DDS_UnsignedLong)
            ((application->sleep_time - wait_timeout.sec * 1000) * 1000 * 1000);

    /* Main loop */
    for (int curr_count = 0;
         (application->count == 0 ) || ( curr_count < application->count );
         ++curr_count)
    {
        /* wait() blocks execution of the thread until one or more attached
         * Conditions become true, or until a user-specified timeout expires.
         */
        retcode = waitset.wait(active_conditions_seq, wait_timeout);
        if (retcode == ${dds2_ns}RETCODE_TIMEOUT)
        {
            printf("Wait timed out. No conditions were triggered.\n");
            continue;
        }
        else if (retcode != ${dds2_ns}RETCODE_OK)
        {
            printf("Wait error: %d\n", retcode);
            break;
        }

        /* Get the number of active conditions */
        active_conditions = active_conditions_seq.length();
        printf("Got %d active conditions\n", active_conditions);

        for (int i = 0; i < active_conditions; ++i)
        {
            /* Compare with Status Conditions */
            if (active_conditions_seq[i] == status_condition)
            {
                /* Get the status changes so we can check which status
                 * condition triggered. */
                ${dds2_ns}StatusMask triggeredmask =
                        hw_datareader->get_status_changes();

                /* Subscription matched */
                if (triggeredmask & DDS_SUBSCRIPTION_MATCHED_STATUS)
                {
                    DDS_SubscriptionMatchedStatus sub_matched_stat;

                    hw_datareader->get_subscription_matched_status(sub_matched_stat);

                    printf(
                        "Subscription matched => Cumulative matches = %d\n",
                        sub_matched_stat.total_count);
                }

                /* Data available */
                if (triggeredmask & (${dds2_ns}StatusMask)${dds2_ns}DATA_AVAILABLE_STATUS)
                {
                    /* Current conditions match our conditions to read data, so
                     * we can read data just like we would do in any other
                     * example. */
                    ${constructMap.nativeFQName}Seq data_seq;
                    ${dds2_ns}SampleInfoSeq info_seq;

                    /* Access data using read(), take(), etc.  If you fail to do
                     * this the condition will remain true, and the WaitSet will
                     * wake up immediately - causing high CPU usage when it does
                     * not sleep in the loop */
                    do
                    {
                        retcode = hw_datareader->take(
                                data_seq, info_seq, ${dds2_ns}LENGTH_UNLIMITED,
                                ${dds2_ns}ANY_SAMPLE_STATE, ${dds2_ns}ANY_VIEW_STATE,
                                ${dds2_ns}ANY_INSTANCE_STATE);
                        if (retcode == ${dds2_ns}RETCODE_OK)
                        {
                            for (int j = 0; j < data_seq.length(); ++j)
                            {
                                if (!info_seq[j].valid_data)
                                {
                                    printf("Got metadata. Instance State: %d.\n",
                                            info_seq[j].instance_state);
                                }
                                else
                                {
                                    #if ($constructMap.languageBinding.equals("FLAT_DATA"))
                                    // To access the data members, get the root to the flat-data sample:
                                    // ${constructMap.nativeFQName}Offset sample_root = sample_seq[i]->root();
                                    // use flat-data APIs to access individual members
                                    total_samples++;
                                    #elseif(${constructMap.isMetpType})
                                    ${dds2_ns}Boolean is_data_consistent = ${dds2_ns}BOOLEAN_FALSE;
                                    ${constructMap.nativeFQName} *sample = NULL;

                                    sample = &data_seq[j];

                                    retcode = hw_datareader->is_data_consistent(
                                                  is_data_consistent,
                                                  *sample,
                                                  info_seq[j]);
                                    if (retcode == ${dds2_ns}RETCODE_OK)
                                    {
                                        if (is_data_consistent)
                                        {
                                            printf("Sample is consistent\n");
                                            printf("Processing is valid\n");
                                            total_samples++;
                                        }
                                        else
                                        {
                                            printf("Sample is NOT consistent\n");
                                        }
                                    }
                                    #else
                                    printf("Data received.\n");
                                    total_samples++;
                                    #end
                                }
                            }
                            /* Return the loaned data */
                            hw_datareader->return_loan(data_seq, info_seq);
                        }
                        else if (retcode != ${dds2_ns}RETCODE_NO_DATA)
                        {
                            printf("Error while reading data! Retcode: %d.\n",
                                    retcode);
                        }
                    } while (retcode == ${dds2_ns}RETCODE_OK);
                }
            }
        }
    }

    ret_value = 0;

    /* Clean the resources */
    done:

#end ##   #subscriberMainWArgsWaitsetWaitForSamplesCPP)


