#macro(functionApplicationCreateDeclare)
struct Application *
Application_create(
    const char *local_participant_name,
    const char *remote_participant_name,
#if (!${use_mag})
    DDS_Long domain_id,
#end
#if ($use_udp && (!${use_mag}))
    char *udp_intf,
    char *peer,
#end
    DDS_Long sleep_time,
#if (${use_secure})
    DDS_Long count,
    struct ApplicationSecMaterial *sec_material)
#else
    DDS_Long count)
#end
{
    DDS_ReturnCode_t retcode;
    DDS_DomainParticipantFactory *factory = NULL;
#if (!${use_autoenable_entities})
    struct DDS_DomainParticipantFactoryQos dpf_qos =
        DDS_DomainParticipantFactoryQos_INITIALIZER;
#end
    struct DDS_DomainParticipantQos dp_qos =
        DDS_DomainParticipantQos_INITIALIZER;
    DDS_Boolean success = DDS_BOOLEAN_FALSE;
    RT_Registry_T *registry = NULL;
#if(${use_udp})
    struct UDP_InterfaceFactoryProperty *udp_property = NULL;
#end
#if( ${constructMap.isMetpType} || ${use_shared_memory})
#if(!$use_zcv2)
    struct NETIO_SHMEMInterfaceFactoryProperty shmem_property =
        NETIO_SHMEMINTERFACE_FACTORY_PROPERTY_DEFAULT;
#end
#end
#if($use_dpde)
    struct DPDE_DiscoveryPluginProperty discovery_plugin_properties =
        DPDE_DiscoveryPluginProperty_INITIALIZER;
#else
    struct DPSE_DiscoveryPluginProperty discovery_plugin_properties =
        DPSE_DiscoveryPluginProperty_INITIALIZER;
#end
#if ($use_zcv2)
    struct ZCOPY_NotifInterfaceFactoryProperty notif_prop =
                ZCOPY_NotifInterfaceFactoryProperty_INITIALIZER;
    struct ZCOPY_NotifMechanismProperty notif_mech_prop =
                ZCOPY_NotifMechanismProperty_INITIALIZER;
#end
    struct Application *application = NULL;
#if (${use_secure})
    struct Application def_application = Application_INITIALIZER;
#end
#if($use_dpde)
    (void)local_participant_name;
    (void)remote_participant_name;
#end
#if ($use_static_udp)
    (void)udp_intf;
#end
#if ($use_psk)
#varPsk()
#end

    /* Uncomment to increase verbosity level:
       OSAPI_Log_set_verbosity(OSAPI_LOG_VERBOSITY_WARNING);
     */
    application = (struct Application *)malloc(sizeof(struct Application));

    if (application == NULL)
    {
        printf("failed to allocate application\n");
        goto done;
    }

    application->sleep_time = sleep_time;
    application->count = count;

    factory = DDS_DomainParticipantFactory_get_instance();

    registry = DDS_DomainParticipantFactory_get_registry(factory);

    if (!RT_Registry_register(
             registry,
             DDSHST_WRITER_DEFAULT_HISTORY_NAME,
             WHSM_HistoryFactory_get_interface(),
             NULL,
             NULL))
    {
        printf("failed to register wh\n");
        goto done;
    }

    if (!RT_Registry_register(
             registry,
             DDSHST_READER_DEFAULT_HISTORY_NAME,
             RHSM_HistoryFactory_get_interface(),
             NULL,
             NULL))
    {
        printf("failed to register rh\n");
        goto done;
    }

    /* If the UDP transport has already been registered, unregister it to
     * set new properties.
     */
    if (RT_Registry_unregister(registry, NETIO_DEFAULT_UDP_NAME, NULL, NULL))
    {
        printf("Unregistered existing UDP transport.\n");
    }
#if(${use_udp})
    udp_property = (struct UDP_InterfaceFactoryProperty *)
        malloc(sizeof(struct UDP_InterfaceFactoryProperty));
    if (udp_property == NULL)
    {
        printf("failed to allocate udp properties\n");
        goto done;
    }
    *udp_property = UDP_INTERFACE_FACTORY_PROPERTY_DEFAULT;

#if (!$use_static_udp)
    /* For additional allowed interface(s), increase maximum and length, and
       set interface below:
    */
    if (!DDS_StringSeq_set_maximum(&udp_property->allow_interface,2))
    {
        printf("failed to set allow_interface maximum\n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&udp_property->allow_interface,2))
    {
        printf("failed to set allow_interface length\n");
        goto done;
    }

    /* loopback interface */
${envMap.POUND_CHAR}if defined(RTI_DARWIN) || defined(RTI_VXWORKS) || defined(RTI_QNX)
    *DDS_StringSeq_get_reference(&udp_property->allow_interface,0) =
         DDS_String_dup("lo0");
${envMap.POUND_CHAR}elif defined (RTI_LINUX)
    *DDS_StringSeq_get_reference(&udp_property->allow_interface,0) =
        DDS_String_dup("lo");
${envMap.POUND_CHAR}elif defined(RTI_WIN32)
    *DDS_StringSeq_get_reference(&udp_property->allow_interface,0) =
        DDS_String_dup("Loopback Pseudo-Interface 1");
${envMap.POUND_CHAR}else
    *DDS_StringSeq_get_reference(&udp_property->allow_interface,0) =
        DDS_String_dup("lo");
${envMap.POUND_CHAR}endif

    if (udp_intf != NULL)
    { /* use interface supplied on command line */
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup(udp_intf);
    }
    else                /* use hardcoded interface */
    {
${envMap.POUND_CHAR}if defined(RTI_DARWIN)
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup("en1");
${envMap.POUND_CHAR}elif defined (RTI_LINUX)
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup("eth0");
${envMap.POUND_CHAR}elif defined (RTI_VXWORKS)
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup("geisc0");
${envMap.POUND_CHAR}elif defined(RTI_WIN32)
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup("Local Area Connection");
${envMap.POUND_CHAR}else
        *DDS_StringSeq_get_reference(&udp_property->allow_interface,1) =
            DDS_String_dup("ce0");
${envMap.POUND_CHAR}endif
    }
#else
    /* In this example we manually configure what interfaces are available.
     * First we disable reading out the interface list. Note that on some
     * platforms reading out the interface list has been compiled out, so
     * this property has no effect.
     */
#if (!$use_cert_api_only)
    udp_property->disable_auto_interface_config = RTI_TRUE;
#end
    /* Allow and deny lists are still valid. If none are specified then
     * all interfaces are valid.
     */
    if (!DDS_StringSeq_set_maximum(&udp_property->allow_interface,1))
    {
        printf("failed to set allow_interface maximum\n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&udp_property->allow_interface,1))
    {
        printf("failed to set allow_interface length\n");
        goto done;
    }

    /* The name of the interface can be the anything, upto
     * UDP_INTERFACE_MAX_IFNAME characters including the '\0' character
     */
    *DDS_StringSeq_get_reference(&udp_property->allow_interface,0) =
        DDS_String_dup("loopback");

    /* This function takes the following arguments:
     * Param 1 is the iftable in the UDP property
     * Param 2 is the IP address of the interface in host order
     * Param 3 is the Netmask of the interface
     * Param 4 is the name of the interface
     * Param 5 are flags. The following flags are supported (use OR for multiple):
     *      UDP_INTERFACE_INTERFACE_UP_FLAG - Interface is up
     *      UDP_INTERFACE_INTERFACE_MULTICAST_FLAG - Interface supports multicast
     */
    if (!UDP_InterfaceTable_add_entry(
             &udp_property->if_table,
             0x7f000001,
             0xff000000,
             "loopback",
#if($use_cert_api_only)
             UDP_INTERFACE_INTERFACE_UP_FLAG))
#else
             UDP_INTERFACE_INTERFACE_UP_FLAG |
             UDP_INTERFACE_INTERFACE_MULTICAST_FLAG))
#end
    {
        printf("failed to add interface\n");
        goto done;
    }
#end

    if (!RT_Registry_register(
             registry,
             NETIO_DEFAULT_UDP_NAME,
             UDP_InterfaceFactory_get_interface(),
             (struct RT_ComponentFactoryProperty*)udp_property,
             NULL))
    {
       printf("failed to register udp\n");
       goto done;
    }

#end ##  #if(!${use_shared_memory})
#if (!${use_autoenable_entities})
    DDS_DomainParticipantFactory_get_qos(factory, &dpf_qos);
    dpf_qos.entity_factory.autoenable_created_entities = DDS_BOOLEAN_FALSE;
    DDS_DomainParticipantFactory_set_qos(factory, &dpf_qos);

#end ## use_autoenable_entities

#if ($use_zcv2)
    if (!NDDS_Transport_ZeroCopy_initialize(registry, NULL, NULL))
    {
        printf("failed to initialize Zerocopy \n");
        goto done;
    }

    /* The following QoS can be used to configure Zero Copy v2. */
    /* The Notification interface address: */
    notif_mech_prop.intf_addr = 0;

    /* User property that is handed to the downstream transport. */
    notif_prop.user_property = &notif_mech_prop;

    /* The maximum number of samples that each notification interface
     * can process for the DataReader. */
    notif_prop.max_samples_per_notif = 1;

    if (!ZCOPY_NotifMechanism_register(registry, NETIO_DEFAULT_NOTIF_NAME, &notif_prop))
    {
        printf("failed to register notif\n");
        goto done;
    }

#end

#if ($use_content_filter)
    /* Enable the content filtering feature */
    if (DDS_FilterPluginFactory_register() != DDS_RETCODE_OK)
    {
        printf("failed to register filter plugin factory\n");
        goto done;
    }

#end

#if(!${use_shared_memory})
    if (peer == NULL)
    {
        peer = "_udp://127.0.0.1"; /* default to loopback */
    }

#end
#if($use_dpde)
#if($use_secure)
    /* In order to speed up mutual detection between participants and trigger
     * the authentication handshake, we reduce the liveliness assertion period
     * in the discovery plugin properties */
    discovery_plugin_properties.participant_liveliness_assert_period.sec = 5;

#end
    if (!RT_Registry_register(
             registry,
             "dpde",
             DPDE_DiscoveryFactory_get_interface(),
             &discovery_plugin_properties._parent,
             NULL))
    {
        printf("failed to register dpde\n");
        goto done;
    }
#else
#if ($use_secure)
    /* In order to speed up mutual detection between participants and trigger
     * the authentication handshake, we reduce the liveliness assertion period
     * in the discovery plugin properties */
    dpse_properties.participant_liveliness_assert_period.sec = 5;

#end
    if (!RT_Registry_register(
             registry,
             "dpse",
             DPSE_DiscoveryFactory_get_interface(),
             &discovery_plugin_properties._parent,
             NULL))
    {
        printf("failed to register dpse\n");
        goto done;
    }
#end

    if (!RT_ComponentFactoryId_set_name(&dp_qos.discovery.discovery.name,"$discovery_plugin_name"))
    {
        printf("failed to set discovery plugin name\n");
        goto done;
    }

#if( ${constructMap.isMetpType} || ${use_shared_memory})
#if(!$use_zcv2)
    if (!RT_Registry_register(
             registry,
             NETIO_DEFAULT_SHMEM_NAME,
             NETIO_SHMEMInterfaceFactory_get_interface(),
             (struct RT_ComponentFactoryProperty*) &shmem_property,
             NULL))
    {
        printf("failed to register shmem\n");
        goto done;
    }
#end
#if(${use_shared_memory})
    if (!DDS_StringSeq_set_maximum(&dp_qos.transports.enabled_transports, 1))
    {
        printf("failed to set transports.enabled_transports maximum\n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&dp_qos.transports.enabled_transports, 1))
    {
        printf("failed to set transports.enabled_transports length\n");
        goto done;
    }
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,0) = DDS_String_dup(NETIO_DEFAULT_SHMEM_NAME);

    DDS_StringSeq_set_maximum(&dp_qos.discovery.enabled_transports,1);
    DDS_StringSeq_set_length(&dp_qos.discovery.enabled_transports,1);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,0) = DDS_String_dup("_shmem://");

    DDS_StringSeq_set_maximum(&dp_qos.user_traffic.enabled_transports,1);
    DDS_StringSeq_set_length(&dp_qos.user_traffic.enabled_transports,1);
    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,0) = DDS_String_dup("_shmem://");

    DDS_StringSeq_set_maximum(&dp_qos.discovery.initial_peers,1);
    DDS_StringSeq_set_length(&dp_qos.discovery.initial_peers,1);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.initial_peers,0) = DDS_String_dup("_shmem://");
#elseif(${use_zcv2})
    if (!DDS_StringSeq_set_maximum(&dp_qos.transports.enabled_transports, 2))
    {
        printf("failed to set transports.enabled_transports maximum \n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&dp_qos.transports.enabled_transports, 2))
    {
        printf("failed to set transports.enabled_transports length \n");
        goto done;
    }

    /* Enabled UDP and notification: */
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,0) = DDS_String_dup("notif");
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,1) = DDS_String_dup(NETIO_DEFAULT_UDP_NAME);

    /* Only enabled discovery for UDP: */
    DDS_StringSeq_set_maximum(&dp_qos.discovery.enabled_transports,1);
    DDS_StringSeq_set_length(&dp_qos.discovery.enabled_transports,1);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,0) = DDS_String_dup("_udp://");

    /* User traffic is only on notification: */
    DDS_StringSeq_set_maximum(&dp_qos.user_traffic.enabled_transports,1);
    DDS_StringSeq_set_length(&dp_qos.user_traffic.enabled_transports,1);
    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,0) = DDS_String_dup("notif://");

    /* Default Peer: */
    DDS_StringSeq_set_maximum(&dp_qos.discovery.initial_peers,1);
    DDS_StringSeq_set_length(&dp_qos.discovery.initial_peers,1);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.initial_peers,0) = DDS_String_dup(peer);
#else
    if (!DDS_StringSeq_set_maximum(&dp_qos.transports.enabled_transports, 2))
    {
        printf("failed to set transports.enabled_transports maximum\n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&dp_qos.transports.enabled_transports, 2))
    {
        printf("failed to set transports.enabled_transports length\n");
        goto done;
    }
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,0) = DDS_String_dup(NETIO_DEFAULT_SHMEM_NAME);
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,1) = DDS_String_dup(NETIO_DEFAULT_UDP_NAME);

    DDS_StringSeq_set_maximum(&dp_qos.discovery.enabled_transports,2);
    DDS_StringSeq_set_length(&dp_qos.discovery.enabled_transports,2);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,0) = DDS_String_dup("_shmem://");
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,1) = DDS_String_dup("_udp://");

    DDS_StringSeq_set_maximum(&dp_qos.user_traffic.enabled_transports,2);
    DDS_StringSeq_set_length(&dp_qos.user_traffic.enabled_transports,2);
    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,0) = DDS_String_dup("_shmem://");
    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,1) = DDS_String_dup("_udp://");

    DDS_StringSeq_set_maximum(&dp_qos.discovery.initial_peers,2);
    DDS_StringSeq_set_length(&dp_qos.discovery.initial_peers,2);
    *DDS_StringSeq_get_reference(&dp_qos.discovery.initial_peers,0) = DDS_String_dup("_shmem://");
    *DDS_StringSeq_get_reference(&dp_qos.discovery.initial_peers,1) = DDS_String_dup(peer);
#end
#else

    if (!DDS_StringSeq_set_maximum(&dp_qos.transports.enabled_transports,1))
    {
        printf("failed to set maximum for transports.enabled_transports\n");
        goto done;
    }

    if (!DDS_StringSeq_set_length(&dp_qos.transports.enabled_transports,1))
    {
        printf("failed to set length for transports.enabled_transports\n");
        goto done;
    }
    *DDS_StringSeq_get_reference(&dp_qos.transports.enabled_transports,0) = DDS_String_dup("_udp");

    if (!DDS_StringSeq_set_maximum(&dp_qos.discovery.enabled_transports,3))
    {
        printf("failed to set maximum for discovery.enabled_transports\n");
        goto done;
    }

    if (!DDS_StringSeq_set_length(&dp_qos.discovery.enabled_transports,3))
    {
        printf("failed to set length for discovery.enabled_transports\n");
        goto done;
    }

    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,0) =
                                     DDS_String_dup("_udp://239.255.0.1");
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,1) =
                                     DDS_String_dup("_udp://");
    *DDS_StringSeq_get_reference(&dp_qos.discovery.enabled_transports,2) =
                                     DDS_String_dup("_udp://127.0.0.1");

    if (!DDS_StringSeq_set_maximum(&dp_qos.user_traffic.enabled_transports,2))
    {
        printf("failed to set maximum for user_traffic.enabled_transports\n");
        goto done;
    }

    if (!DDS_StringSeq_set_length(&dp_qos.user_traffic.enabled_transports,2))
    {
        printf("failed to set length for user_traffic.enabled_transports\n");
        goto done;
    }

    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,0) =
                        DDS_String_dup("_udp://");
    *DDS_StringSeq_get_reference(&dp_qos.user_traffic.enabled_transports,1) =
                        DDS_String_dup("_udp://127.0.0.1");

    if (!DDS_StringSeq_set_maximum(&dp_qos.discovery.initial_peers,1))
    {
        printf("failed to set initial peers maximum\n");
        goto done;
    }
    if (!DDS_StringSeq_set_length(&dp_qos.discovery.initial_peers,1))
    {
        printf("failed to set initial peers length\n");
        goto done;
    }
    *DDS_StringSeq_get_reference(&dp_qos.discovery.initial_peers,0) =
        DDS_String_dup(peer);
#end

    /* if there are more remote or local endpoints, you need to increase these limits */
    dp_qos.resource_limits.max_destination_ports = 32;
    dp_qos.resource_limits.max_receive_ports = 32;
    dp_qos.resource_limits.local_topic_allocation = 1;
    dp_qos.resource_limits.local_type_allocation = 1;
    dp_qos.resource_limits.local_reader_allocation = 1;
    dp_qos.resource_limits.local_writer_allocation = 1;
    dp_qos.resource_limits.remote_participant_allocation = 8;
    dp_qos.resource_limits.remote_reader_allocation = 8;
    dp_qos.resource_limits.remote_writer_allocation = 8;
#if ($use_psk)
#setupPsk()
#end
#if($use_crc)
    /* The following QoS can be used to configure checksum.
     * compute_crc indicates to add the RTPS checksum submessage to every
     * message. check_crc enables validation of received checksum submessages.
     * computed_crc_kind is a bitmask indicating which checksum is used for
     * sent messages. allowed_crc_mask is a mask of checksums that are enabled
     * for validating incoming packets. require_crc requires discovered
     * participants to send a checksum. Currently Connext DDS Pro does not
     * support require_crc as an option so it is set to false so that the
     * application interoperates with Pro.
     */
    dp_qos.protocol.compute_crc = DDS_BOOLEAN_TRUE;
    dp_qos.protocol.check_crc = DDS_BOOLEAN_TRUE;
    dp_qos.protocol.require_crc = DDS_BOOLEAN_FALSE;
    dp_qos.protocol.computed_crc_kind =  DDS_CHECKSUM_BUILTIN128;
    dp_qos.protocol.allowed_crc_mask = DDS_CHECKSUM_BUILTIN_ANY;
#end

#if(!$use_dpde)
    /* Must set the name of the domain participant in QoS for discovery */
    strncpy(dp_qos.participant_name.name,
            local_participant_name,
            sizeof(dp_qos.participant_name.name) - 1);
    dp_qos.participant_name.name[sizeof(dp_qos.participant_name.name) - 1] = '\0';
#end

#configureContentFilterResourceLimits()

#if (${use_secure})
${envMap.POUND_CHAR}ifdef USE_SECURITY
    /* Register security plugin factories and configure QoS to enable them */
    if (!Application_configure_security(
            application, registry, &dp_qos, sec_material))
    {
        printf("failed to configure security\n");
        goto done;
    }
${envMap.POUND_CHAR}endif /* USE_SECURITY */
#end
    application->participant = DDS_DomainParticipantFactory_create_participant(
                                   factory,
                                   domain_id,
                                   &dp_qos,
                                   NULL,
                                   DDS_STATUS_MASK_NONE);

    if (application->participant == NULL)
    {
        printf("failed to create participant\n");
        goto done;
    }

    strncpy(application->type_name,
            ${constructMap.nativeFQName}TypeSupport_get_type_name(),
            sizeof(application->type_name) - 1);
    application->type_name[sizeof(application->type_name) - 1] = '\0';
    retcode = ${constructMap.nativeFQName}TypeSupport_register_type(
                  application->participant,
                  application->type_name);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to register type: %s\n", application->type_name);
        goto done;
    }

    snprintf(application->topic_name,
             sizeof(application->topic_name),
             "Example %s",
             "${constructMap.nativeFQName}");

    application->topic = DDS_DomainParticipant_create_topic(
                             application->participant,
                             application->topic_name,
                             application->type_name,
                             &DDS_TOPIC_QOS_DEFAULT,
                             NULL,
                             DDS_STATUS_MASK_NONE);
    if (application->topic == NULL)
    {
        printf("topic == NULL\n");
        goto done;
    }

#if(!$use_dpde)
    retcode = DPSE_RemoteParticipant_assert(
                  application->participant,
                  remote_participant_name);
    if (retcode != DDS_RETCODE_OK)
    {
        printf("failed to assert remote participant\n");
        goto done;
    }
#end

    success = DDS_BOOLEAN_TRUE;

  done:
${envMap.POUND_CHAR}ifndef RTI_CERT
    DDS_DomainParticipantQos_finalize(&dp_qos);
${envMap.POUND_CHAR}endif

    if (!success)
    {
#if (${use_udp})
${envMap.POUND_CHAR}ifndef RTI_CERT
        if (udp_property != NULL)
        {
            UDP_InterfaceFactoryProperty_finalize(udp_property);
            free(udp_property);
        }
${envMap.POUND_CHAR}endif

#end
        if (application != NULL)
        {
${envMap.POUND_CHAR}ifndef RTI_CERT
            free(application);
${envMap.POUND_CHAR}endif
            application = NULL;
        }
    }

    return application;
}
#end  ## #macro(functionApplicationCreateDeclare)


