                 || $node.constructKind.equals("valueTypeFwd")
                 || $node.constructKind.equals("unionFwd"))
#*----*##if($envMap.language.equals("C")
               || $node.constructKind.equals("unionFwd"))
struct ${node.nativeFQNameInModule};
#*----*##else
class ${node.nativeFQNameInModule};
#*----*##end
#*--*##else
#*----*##if($node.constructKind.equals("enum"))
#declareEnumMicroMicro($node)
#*----*##elseif($node.constructKind.equals("alias"))
#createTypeFieldMicroMicro($node.memberFieldMapList $node)
#defineAliasMicroMicro($node)
