<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- ================================================================== -->
    <!-- Application and Application Library Definition -->
    <!-- ================================================================== -->

    <!-- <xs:include schemaLocation="http://www.omg.org/spec/DDS-XML/20180501/dds-xml_domainparticipant_definitions_nonamespace.xsd" /> -->
    <!-- <xs:include schemaLocation="ProSchema/definitions/rti_dds_profiles_definitions.xsd"/> -->
    <!-- <xs:include schemaLocation="rti_dds_profiles.xsd"/> -->
    <xs:include schemaLocation="definitions/rti_dds_profiles_definitions.xsd"/>

    <!-- equivalent to participantLibrary -->
    <xs:complexType name="application">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="domain_participant" maxOccurs="unbounded"
                        type="participant" />
        </xs:choice>

        <xs:attribute name="name" type="elementName" use="required" />
        <xs:attribute name="isCert" type="xs:boolean" use="required" />
    </xs:complexType>

    <xs:complexType name="applicationLibrary">
        <xs:choice minOccurs="1" maxOccurs="unbounded">
            <xs:element name="application" maxOccurs="unbounded"
                        type="application" />
        </xs:choice>

        <xs:attribute name="name" type="elementName" use="required" />
    </xs:complexType>

</xs:schema>
