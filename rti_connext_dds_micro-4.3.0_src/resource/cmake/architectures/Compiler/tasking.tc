## Use RTIME_TARGET_NAME when inside the cmake command try_compile
SET(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RTIME_TARGET_NAME)

IF (DEFINED ENV{RTIME_TASKING_PATH})
    STRING(REPLACE "\\" "/" COMPILER_PATH $ENV{RTIME_TASKING_PATH})
    SET(_RTIME_IGNORE_CFLAGS TRUE)
ELSE()
    MESSAGE(FATAL_ERROR "Please set the RTIME_TASKING_PATH environment variable.\n"
                        "Example: set RTIME_TASKING_PATH=c:\\TASKING\\TriCorev6.3r1")
ENDIF()

## Check for Windows ##
IF( WIN32 ) # true if windows (32 and 64 bit)
    SET(PROGRAM_EXTENSION ".exe")

    #Disable response files because artc.exe doesn't support it.
    #But for some reason CMAKE_C_USE_RESPONSE_FILE_FOR_OBJECTS only disables
    #response files for make. So use option -f with the response file instead.
    FOREACH(language C CXX)
        #SET(CMAKE_${language}_USE_RESPONSE_FILE_FOR_OBJECTS 0)
        #SET(CMAKE_${language}_USE_RESPONSE_FILE_FOR_LIBRARIES 0)
        SET(CMAKE_${language}_RESPONSE_FILE_LINK_FLAG "-f ")
    ENDFOREACH()
ELSE()
    SET(PROGRAM_EXTENSION "")
ENDIF()

IF(CMAKE_GENERATOR MATCHES "Unix Makefiles")
    SET(CMAKE_MAKE_PROGRAM "${COMPILER_PATH}/${TASKING_ARCH}/bin/mktc${PROGRAM_EXTENSION}" CACHE FILEPATH "" FORCE)
ENDIF()

SET(TASKING_ARCH ctc)
SET(CMAKE_AR "${COMPILER_PATH}/${TASKING_ARCH}/bin/artc${PROGRAM_EXTENSION}")
FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER ${COMPILER_PATH}/${TASKING_ARCH}/bin/cctc${PROGRAM_EXTENSION})
    SET(CMAKE_${language}_COMPILE_OBJECT "<CMAKE_${language}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -co <SOURCE>")
    SET(CMAKE_${language}_CREATE_STATIC_LIBRARY "${CMAKE_AR} -r <TARGET> <LINK_FLAGS> <OBJECTS>")
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

IF (RTIME_TARGET_NAME MATCHES ".*OsekCore.*")
    # CPU target
    SET(COMMON "--core=tc1.6.x")
    SET(COMMON "${COMMON} --eabi-compliant")
    # With this option you control the language extensions the compiler can accept
    SET(COMMON "${COMMON} --language=-comments,-gcc,+volatile,-strings")
    # Default alignment
    SET(COMMON "${COMMON} --align=4")
ELSEIF (RTIME_TARGET_NAME MATCHES ".*VSTAR.*")
    # CPU target
    SET(COMMON "--core=tc1.6.x")
    # With this option you control the language extensions the compiler can accept
    SET(COMMON "${COMMON} --language=-gcc,-volatile,+strings")
    # Default alignment
    SET(COMMON "${COMMON} --align=64")
ELSEIF (RTIME_TARGET_NAME MATCHES "^tc29xt")
    # CPU target
    SET(COMMON "-Ctc29xb ")
    # With this option you select the core name as specified in a linker script file, for the current task. The control program passes the correct LSL file to the linker and specifies the correct core.
    SET(COMMON "${COMMON} --lsl-core=vtc")
    # With this option you select the floating-point execution model.
    SET(COMMON "${COMMON} --fp-model=-float")
    # With this option you control the language extensions the compiler can accept
    SET(COMMON "${COMMON} --language=-gcc,-volatile,+strings,-kanji")
ELSEIF(RTIME_TARGET_NAME MATCHES "^tc39xt")
    # CPU target
    SET(COMMON "-Ctc39xb")
    SET(COMMON "${COMMON} -D__CPU__=tc39xb") # This cannot be removed
    SET(COMMON "${COMMON} -D__CPU_TC39XB__")
    # Core selection
    SET(COMMON "${COMMON} --core=tc1.6.2")
    # Default alignment
    SET(COMMON "${COMMON} --align=0")
    # To remove the warn 'ctc W504: macro "__CPU__" redefined'
    SET(COMMON "${COMMON} -Wc--no-warnings=504")
    # To remove the warn 'ctc W550: variable _ was set but never used'
    SET(COMMON "${COMMON} -Wcp--no-warnings=550")
    # With this option you select the floating-point execution model. This configuration is called precise
    SET(COMMON "${COMMON} --fp-model=c,F,L,N,R,S,T,Z")
    # With this option you control the language extensions the compiler can accept
    SET(COMMON "${COMMON} --language=-gcc,-volatile,+strings,-kanji")
    # SET(C_FLAGS "${C_FLAGS} -g2")
ELSE()
    MESSAGE(FATAL_ERROR "No architecture recognized, please select one from: tc29xt, tc39xt.")
ENDIF()

# Select the ISO C standard
SET(COMMON "${COMMON} --iso=99")
# With this option you tell the compiler which code must be generated for a switch statement
SET(COMMON "${COMMON} --switch=auto")
# This option is related to the compiler optimization --optimize=+compact (Code compaction or reverse inlining). Code compaction is the opposite of inlining functions: large sequences of code that occur more than once, are transformed into a function. This reduces code size (possibly at the cost of execution speed)
SET(COMMON "${COMMON} --compact-max-size=200")
# With this option you limit the number of error messages in one compiler run to the specified number.
SET(COMMON "${COMMON} --error-limit=1")
# With this option you tell the compiler to merge C source code with generated assembly code in the output file. The C source lines are included as comments.
SET(COMMON "${COMMON} --source")
# Normally the compiler treats enumerated types as the smallest data type possible (char or short instead of int).This reduces code size. With this option the compiler always treats enum-types as int as defined in the ISO C99 standard.
SET(COMMON "${COMMON} --integer-enumeration")
# If the compiler uses certain optimizations (option --optimize), you can use this option to specify whether the used optimizations should optimize for more speed (regardless of code size) or for smaller code size (regardless of speed)
SET(COMMON "${COMMON} -t4")
# With this option you can specify a threshold value for __a0 allocation. -Z is short for --default-a0-size
SET(COMMON "${COMMON} -Z0")
# With this option you can specify a threshold value for __a1 allocation. -Y is short for --default-a1-size
SET(COMMON "${COMMON} -Y0")
# With this option you can specify a threshold value for __near allocation. Prevents near-code optimizations. Difficulties the mpu configuration
SET(COMMON "${COMMON} --default-near-size=0")

SET(CC_COMMON "${COMMON}")
SET(CXX_COMMON "${COMMON} --c++03 --g++")
SET(RELEASE_COMMON "-O2ROP -DNDEBUG") # Careful, use Tasking6.2r2p5 or higher to prevent a bug with optimization
SET(DEBUG_COMMON "-O0 -g2")
    
SET(CMAKE_C_CREATE_PREPROCESSED_SOURCE "<CMAKE_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> --preprocess=cIMPp <SOURCE> > <PREPROCESSED_SOURCE>")
SET(CMAKE_CXX_CREATE_PREPROCESSED_SOURCE "<CMAKE_CXX_COMPILER> <DEFINES> <INCLUDES> <FLAGS> --preprocess=cIMPp <SOURCE> > <PREPROCESSED_SOURCE>")

SET(CMAKE_C_FLAGS_INIT "")
SET(CMAKE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS} ${CC_COMMON} ${DEBUG_COMMON} " CACHE INTERNAL "CMAKE_C_FLAGS_DEBUG" FORCE)
SET(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS} ${CC_COMMON} ${RELEASE_COMMON} " CACHE INTERNAL "CMAKE_C_FLAGS_RELEASE" FORCE)
SET(CMAKE_C_FLAGS_DEBUG_INIT "${CMAKE_C_FLAGS_DEBUG} ")
SET(CMAKE_C_FLAGS_MINSIZEREL_INIT "${CMAKE_C_FLAGS_RELEASE} --tradeoff=4 ")
SET(CMAKE_C_FLAGS_RELEASE_INIT "${CMAKE_C_FLAGS_RELEASE} --tradeoff=2 ")
SET(CMAKE_C_FLAGS_RELWITHDEBINFO_INIT "${CMAKE_C_FLAGS_RELEASE} --tradeoff=0 -g ")

SET(CMAKE_CXX_FLAGS_INIT "")
SET(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS} ${CXX_COMMON} ${DEBUG_COMMON} " CACHE INTERNAL "CMAKE_CXX_FLAGS_DEBUG" FORCE)
SET(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS} ${CXX_COMMON} ${RELEASE_COMMON} " CACHE INTERNAL "CMAKE_CXX_FLAGS_RELEASE" FORCE)
SET(CMAKE_CXX_FLAGS_DEBUG_INIT "${CMAKE_CXX_FLAGS_DEBUG} ")
SET(CMAKE_CXX_FLAGS_MINSIZEREL_INIT "${CMAKE_CXX_FLAGS_RELEASE} --tradeoff=4 ")
SET(CMAKE_CXX_FLAGS_RELEASE_INIT "${CMAKE_CXX_FLAGS_RELEASE} --tradeoff=2 ")
SET(CMAKE_CXX_FLAGS_RELWITHDEBINFO_INIT "${CMAKE_CXX_FLAGS_RELEASE} --tradeoff=0 -g ")

SET(RTIME_OBJDUMP ${COMPILER_PATH}/${TASKING_ARCH}/bin/hldumptc)
SET(RTIME_OBJDUMP_OPT -F0nsf)
SET(RTIME_OBJDUMPCHKSUM ${COMPILER_PATH}/${TASKING_ARCH}/bin/hldumptc)
SET(RTIME_OBJDUMPCHKSUM_OPT -F0Nsf)
SET(RTIME_AR_EXRACT -x)
SET(RTIME_AR ${CMAKE_AR})

IF(WIN32) 
    SET(RTIME_OBJ_SUFFIX obj)
ELSE()
    SET(RTIME_OBJ_SUFFIX o)
ENDIF()

IF (${TARGET_HELP})
    MESSAGE("COMPILER NOTES\n")
    MESSAGE(" The following Tasking specific flags are used based on RTIME_TARGET_NAME\n")
    MESSAGE(" - If tc29xt is part of the name, the TriCore tool-chain is used")
    MESSAGE(" - If tc39xt is part of the name, the TriCore tool-chain is used")
    MESSAGE("\nThe following flags are added:\n")
    MESSAGE(" - For C Debug libraries:  ${CC_COMMON} ${DEBUG_COMMON}")
    MESSAGE(" - For C++ Debug libraries:  ${CXX_COMMON} ${DEBUG_COMMON}")
    MESSAGE(" - For C Release libraries:  ${CC_COMMON} ${RELEASE_COMMON}")
    MESSAGE(" - For C++ Release libraries:  ${CXX_COMMON} ${RELEASE_COMMON}\n")
ENDIF()
