# This architecture is expected to be compiled on a native machine with the
# default compiler
SET(CMAKE_SYSTEM_NAME Linux)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n Linux\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" The Linux target supports self-hosted builds on Linux")
    MESSAGE(" targets")
    MESSAGE("\nARGUMENTS\n")
    MESSAGE(" This target interprets RTIME_TARGET_NAME as follows:")
    MESSAGE(" - if gcc is part of the name the GCC compiler is assumed")
    MESSAGE("\nEXAMPLES\n")
    MESSAGE(" --target Linux --name i86Linux2.6gcc4.7.5\n")
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)

IF (NOT ${TARGET_HELP})
    IF (${RTIME_TARGET_NAME} MATCHES "gcc") 
        INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)
    ELSE()
        MESSAGE(FATAL_ERROR "Unknown compiler specified in ${RTIME_TARGET_NAME}")
    ENDIF()
ELSE()
    INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)
ENDIF()

SET(RTIME_OSAPI_PLATFORM posix)



