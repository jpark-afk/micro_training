INCLUDE(${CMAKE_CURRENT_LIST_DIR}/platform.tc)
SET(MACOSX_BUNDLE_GUI_IDENTIFIER "com.rti.ios.micro.\${PRODUCT_NAME:identifier}")
SET(EXE_APP_TYPE MACOSX_BUNDLE)

IF (${TARGET_HELP})
    MESSAGE("PLATFORM NOTES\n")
    MESSAGE(" For iOS (RTIME_TARGET_NAME includes iOS) the following")
    MESSAGE(" libraries are included:")
    MESSAGE(" - ${PLATFORM_LIBS}")
    MESSAGE("\n")
ENDIF()

SET(_RTIME_OSAPI_PLATFORM posix)
SET(_RTIME_OSAPI_ENABLE_STRICT_POSIX FALSE)
