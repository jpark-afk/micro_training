SET(CMAKE_SYSTEM_NAME Darwin)

SET(CMAKE_POSITION_INDEPENDENT_CODE TRUE)

set(CMAKE_C_FLAGS
        "-std=c99 -Winit-self -fstrict-aliasing \
        -fsigned-char \
        -Wmissing-declarations -Wall -Wextra -Wpedantic -Wshadow \
        -Wcast-align -Wunused -Wconversion -Wsign-conversion  \
        -Wdouble-promotion -Wstrict-aliasing"
)

set(CMAKE_C_FLAGS_RELEASE
        "-O2"
)

set(CMAKE_CXX_FLAGS
        "-Winit-self -fstrict-aliasing \
        -fsigned-char \
        -Wmissing-declarations -Wall -Wextra -Wpedantic \
        -Wshadow -Wnon-virtual-dtor -Wcast-align -Wunused \
        -Woverloaded-virtual -Wconversion -Wsign-conversion \
        -Wdouble-promotion -Wno-long-long -Wstrict-aliasing"
)

set(CMAKE_CXX_FLAGS_RELEASE
        "-O2"
)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n Darwin\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" The Darwin target supports self-hosted builds on Darwin")
    MESSAGE(" targets.")
    MESSAGE("\nARGUMENTS\n")
    MESSAGE(" This target interprets RTIME_TARGET_NAME as follows:")
    MESSAGE(" - if gcc is part of the name the GCC compiler is assumed")
    MESSAGE(" - if clag is part of the name the clang compiler is assumed")
    MESSAGE("\nEXAMPLES\n")
    MESSAGE(" --target arm64Darwin23clang15.0\n")
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/darwin.tc)

IF (${RTIME_TARGET_NAME} MATCHES "clang")
    INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/clang.tc)
ELSE()
    INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)
ENDIF()

SET(RTIME_OSAPI_PLATFORM posix)
