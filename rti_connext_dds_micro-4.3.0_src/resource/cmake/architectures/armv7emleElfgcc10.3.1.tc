SET(CMAKE_SYSTEM_NAME RTIME_FreeRTOS_PI)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n armv7emleElfgcc10.3.1/armv7emleElfgcc10.3.1CERT PIL\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" This PIL target can be used with FreeRTOS")
    MESSAGE(" targets. Before running this target make sure")
    MESSAGE(" you set up the TOOLCHAIN_PATH environment variable.")
    MESSAGE("\nAvailable PSLs for this PIL")
    MESSAGE(" --name armv7emleElfgcc10.3.1-FreeRTOS10.0\n")
    MESSAGE(" --name armv7emleElfgcc10.3.1CERT-FreeRTOS10.0\n")
ENDIF()

FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

IF (${RTI_BUILD_UNITTESTS})
    ADD_DEFINITIONS(-D__freertos__)
ENDIF()

SET(CMAKE_C_COMPILER   arm-none-eabi-gcc "--specs=nosys.specs --specs=nano.specs")
SET(CMAKE_CXX_COMPILER arm-none-eabi-g++ "--specs=nosys.specs --specs=nano.specs")

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/armgcc_pi.tc)

INCLUDE_ARMGCC_COMPILER_PIL("10.3.1")