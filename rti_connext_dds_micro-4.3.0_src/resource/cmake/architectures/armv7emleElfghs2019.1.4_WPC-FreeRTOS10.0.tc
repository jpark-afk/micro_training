SET(CMAKE_SYSTEM_NAME FreeRTOS)

# This PSL is a Forge-managed test architecture (see foundry-forge's
# forge/config/arch_map.yaml, mapped to S32G2m7-FreeRTOS10-ghs-LwIP) and
# always builds/runs through the Forge unit test harness, so force this on
# rather than relying on it being passed via -D on the command line.
SET(RTI_BUILD_FORGE_UNITTESTS TRUE)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n armv7emleElfghs2019.1.4_WPC-FreeRTOS10.0/armv7emleElfghs2019.1.4_WPCCERT-FreeRTOS10.0 PSL\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" This PSL target cross-compiles for FreeRTOS on the WPC")
    MESSAGE(" (CYT3BB / tviibh4m) GHS ARM Cortex-M7 target. Internal test")
    MESSAGE(" target only (runs on the S32G test board) - not shipped to")
    MESSAGE(" the customer.")
    MESSAGE("\nThis PSL is based on the following PIL:\n")
    MESSAGE(" --name armv7emleElfghs2019.1.4_WPC // armv7emleElfghs2019.1.4_WPCCERT\n")
ENDIF()

FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

ADD_DEFINITIONS(-DHAVE_SOCKET_API)
ADD_DEFINITIONS(-DLWIP_SYS)
ADD_DEFINITIONS(-D__freertos__)

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/ghs_arm_pi.tc)

INCLUDE_GHS_ARM_COMPILER_PSL("2019.1.4")

SET(WPC_PSL_FLAGS
    --gnu_asm
    -Osize
    -DCYT3BBBCES
    -Dcyt3bb
    -Dtviibh4m
)
FOREACH(flag ${WPC_PSL_FLAGS})
    SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${flag}")
ENDFOREACH()
