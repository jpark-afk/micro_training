SET(CMAKE_SYSTEM_NAME Linux)

SET(CMAKE_POSITION_INDEPENDENT_CODE TRUE)

IF(NOT DEFINED COMPILER_PREFIX)
  SET(COMPILER_PREFIX "aarch64-linux-gnu-")
ENDIF()

IF(DEFINED COMPILER_PATH)
  SET(CMAKE_C_COMPILER "${COMPILER_PATH}/${COMPILER_PREFIX}gcc")
  SET(CMAKE_CXX_COMPILER "${COMPILER_PATH}/${COMPILER_PREFIX}g++")
  SET(RTIME_OBJDUMP "${COMPILER_PATH}/${COMPILER_PREFIX}objdump")
  SET(RTIME_OBJDUMPCHKSUM "${COMPILER_PATH}/${COMPILER_PREFIX}objdump")
  SET(RTIME_AR "${COMPILER_PATH}/${COMPILER_PREFIX}ar")
ELSE()
  SET(CMAKE_C_COMPILER "${COMPILER_PREFIX}gcc")
  SET(CMAKE_CXX_COMPILER "${COMPILER_PREFIX}g++")
  SET(RTIME_OBJDUMP "${COMPILER_PREFIX}objdump")
  SET(RTIME_OBJDUMPCHKSUM "${COMPILER_PREFIX}objdump")
  SET(RTIME_AR "${COMPILER_PREFIX}ar")
ENDIF()

SET(RTIME_OBJDUMPCHKSUM_OPT --section=.text --section=.data --section=.rodata --disassemble-all)
SET(RTIME_OBJ_SUFFIX o)
SET(RTIME_AR_EXRACT -x)

SET(RTIME_PLATFORM_SUPPORTS_ZCOPY_V2 TRUE CACHE BOOL "Platform supports ZCOPYv2")

SET(RTIME_INCLUDE_PSL_PSK_SUPPORT TRUE CACHE BOOL "Enable PSL PSK")

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/linux.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc.tc)

SET(RTIME_OSAPI_PLATFORM posix)
