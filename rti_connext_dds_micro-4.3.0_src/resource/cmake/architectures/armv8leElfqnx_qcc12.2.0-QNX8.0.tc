SET(CMAKE_SYSTEM_NAME QNX)
SET(CMAKE_SYSTEM_VERSION 8.0)

SET(RTIME_PLATFORM_SUPPORTS_ZCOPY_V2 TRUE CACHE BOOL "Platform supports ZCOPYv2")
SET(RTIME_INCLUDE_PSL_PSK_SUPPORT TRUE CACHE BOOL "Enable PSL PSK")

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Platform/qnx.tc)
INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/qcc_pi.tc)

INCLUDE_QCC_COMPILER_PSL("12.2.0" "" "" "" "")

SET(RTIME_OSAPI_PLATFORM posix)

SET(RTIME_OSAPI_ENABLE_STRICT_POSIX TRUE)

IF (NOT DEFINED RTIME_UDP_ENABLE_MULTICAST)
    SET(RTIME_UDP_ENABLE_MULTICAST TRUE)
ENDIF()