SET(CMAKE_SYSTEM_NAME MICROSAR)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n")
    MESSAGE("tc39xtElfTasking6.3r1-MICROSAR4\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" This Microsar PSL target can be used for cross-compiling the")
    MESSAGE(" target. The compiler and options are determined based on the")
    MESSAGE(" TOOLCHAIN_PATH, CONFIG_PATH, OSEK_PATH and RTIME_TASKING_PATH")
    MESSAGE("\nThis PSL is based on the following PIL:\n")
    MESSAGE(" tc39xtElfTasking6.3r1\n")
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/tasking_pi.tc)

FOREACH(language C CXX)
    SET(CMAKE_${language}_COMPILER_WORKS 1)
    SET(CMAKE_${language}_ABI_COMPILED 1)
ENDFOREACH()

IF(NOT DEFINED RTI_BUILD_FORGE_UNITTESTS)
    SET(RTI_BUILD_FORGE_UNITTESTS 1)
ENDIF()

SET(RTIME_EXCLUDE_NETIO_ZCOPY TRUE)
# ADD_DEFINITIONS(-DOSAPI_CC_DEF_H=osapi_cc_autosar.h)

INCLUDE_TASKING_COMPILER_PSL("6.3r1")
