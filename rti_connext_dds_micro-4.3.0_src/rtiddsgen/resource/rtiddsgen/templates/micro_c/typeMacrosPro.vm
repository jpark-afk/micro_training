#macro(initializeWParamsMember $member $node $cppConstructor)
#*--*##if ($member.isOptional)
if (!allocParams->allocate_optional_members) {
#if(($member.strSize && !$envMap.useStdString) && $member.typeKind.equals("user"))
        $member.sample=NULL;
#else
        $member.sampleRef=NULL;
#end
    } else {
#*--*##end
